<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>BundlerIntegrationFixture</AssemblyName>
    <Version>1.0.0</Version>
    <RestoreSources>$(BundlerPackageSource)</RestoreSources>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerIntegrationPackageId Condition="'$(BundlerIntegrationPackageId)' == ''">DotNet.Bundler</BundlerIntegrationPackageId>
    <BundlerIdentifier>com.dotnetbundler.integrationfixture</BundlerIdentifier>
    <BundlerProductName>Bundler Integration Fixture</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Tests</BundlerPublisher>
    <BundlerDescription>Disposable Windows NSIS integration-test fixture.</BundlerDescription>
    <BundlerHomepage>https://example.com/dotnet-bundler-fixture</BundlerHomepage>
    <BundlerCopyright>Copyright DotNet.Bundler Tests</BundlerCopyright>
    <BundlerLicenseFile>$(MSBuildProjectDirectory)\Assets\license.txt</BundlerLicenseFile>
    <BundlerOutputPath>$(BundlerIntegrationOutput)</BundlerOutputPath>
    <BundlerNsisLanguages>English;SimpChinese</BundlerNsisLanguages>
    <BundlerNsisDisplayLanguageSelector>true</BundlerNsisDisplayLanguageSelector>
    <BundlerNsisInstallMode Condition="'$(BundlerNsisInstallMode)' == ''">currentUser</BundlerNsisInstallMode>
    <BundlerNsisInstallerIcon>$(BundlerTestIcon)</BundlerNsisInstallerIcon>
    <BundlerNsisUninstallerIcon>$(BundlerTestIcon)</BundlerNsisUninstallerIcon>
    <BundlerNsisHeaderImage>$(BundlerTestHeaderImage)</BundlerNsisHeaderImage>
    <BundlerNsisSidebarImage>$(BundlerTestSidebarImage)</BundlerNsisSidebarImage>
    <BundlerNsisInstallerHooks>$(MSBuildProjectDirectory)\Assets\installer-hooks.nsh</BundlerNsisInstallerHooks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(BundlerIntegrationPackageId)" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerIcon Include="$(BundlerTestIcon)" Condition="'$(BundlerTestIcon)' != ''" />
    <BundlerResource Include="Assets\license.txt" TargetPath="docs\license.txt" />
    <BundlerFileAssociation Include="dbfixture"
                            Name="DotNet.Bundler fixture document"
                            Description="Disposable DotNet.Bundler integration fixture document"
                            MimeType="application/x-dotnet-bundler-fixture" />
    <BundlerUrlProtocol Include="bundlerfixture" Name="DotNet.Bundler fixture link" />
  </ItemGroup>
</Project>
