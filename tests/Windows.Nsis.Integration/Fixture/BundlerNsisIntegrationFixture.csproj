<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>BundlerIntegrationFixture</AssemblyName>
    <Version>1.0.0</Version>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerIntegrationPackageId Condition="'$(BundlerIntegrationPackageId)' == ''">DotNet.Bundler</BundlerIntegrationPackageId>
    <BundlerIntegrationIdentifier Condition="'$(BundlerIntegrationIdentifier)' == ''">com.dotnetbundler.integrationfixture</BundlerIntegrationIdentifier>
    <BundlerIntegrationProductName Condition="'$(BundlerIntegrationProductName)' == ''">Bundler Integration Fixture</BundlerIntegrationProductName>
    <BundlerIntegrationPublisher Condition="'$(BundlerIntegrationPublisher)' == ''">DotNet.Bundler Tests</BundlerIntegrationPublisher>
    <BundlerIntegrationDescription Condition="'$(BundlerIntegrationDescription)' == ''">Disposable Windows NSIS integration-test fixture.</BundlerIntegrationDescription>
    <BundlerIntegrationLanguages Condition="'$(BundlerIntegrationLanguages)' == ''">English;SimpChinese</BundlerIntegrationLanguages>
    <BundlerIntegrationDisplayLanguageSelector Condition="'$(BundlerIntegrationDisplayLanguageSelector)' == ''">true</BundlerIntegrationDisplayLanguageSelector>
    <BundlerIntegrationShortcutArguments Condition="'$(BundlerIntegrationShortcutArguments)' == ''">--shortcut-mode &quot;hello world&quot;</BundlerIntegrationShortcutArguments>
    <BundlerIntegrationShortcutStartMenuFolder Condition="'$(BundlerIntegrationShortcutStartMenuFolder)' == ''">DotNet Bundler Integration</BundlerIntegrationShortcutStartMenuFolder>
    <BundlerIdentifier>$(BundlerIntegrationIdentifier)</BundlerIdentifier>
    <BundlerProductName>$(BundlerIntegrationProductName)</BundlerProductName>
    <BundlerPublisher>$(BundlerIntegrationPublisher)</BundlerPublisher>
    <BundlerDescription>$(BundlerIntegrationDescription)</BundlerDescription>
    <BundlerHomepage>https://example.com/dotnet-bundler-fixture</BundlerHomepage>
    <BundlerCopyright>Copyright DotNet.Bundler Tests</BundlerCopyright>
    <BundlerLicenseFile>$(MSBuildProjectDirectory)\Assets\license.txt</BundlerLicenseFile>
    <BundlerOutputPath>$(BundlerIntegrationOutput)</BundlerOutputPath>
    <BundlerNsisLanguages>$(BundlerIntegrationLanguages)</BundlerNsisLanguages>
    <BundlerNsisDisplayLanguageSelector>$(BundlerIntegrationDisplayLanguageSelector)</BundlerNsisDisplayLanguageSelector>
    <BundlerNsisInstallMode Condition="'$(BundlerNsisInstallMode)' == ''">currentUser</BundlerNsisInstallMode>
    <BundlerIntegrationInstallerHooks Condition="'$(BundlerIntegrationInstallerHooks)' == ''">$(MSBuildProjectDirectory)\Assets\installer-hooks.nsh</BundlerIntegrationInstallerHooks>
    <BundlerNsisInstallerIcon>$(BundlerTestIcon)</BundlerNsisInstallerIcon>
    <BundlerNsisUninstallerIcon>$(BundlerTestIcon)</BundlerNsisUninstallerIcon>
    <BundlerNsisHeaderImage>$(BundlerTestHeaderImage)</BundlerNsisHeaderImage>
    <BundlerNsisSidebarImage>$(BundlerTestSidebarImage)</BundlerNsisSidebarImage>
    <BundlerNsisInstallerHooks>$(BundlerIntegrationInstallerHooks)</BundlerNsisInstallerHooks>
    <BundlerNsisShortcutDesktop Condition="'$(BundlerNsisShortcutDesktop)' == ''">true</BundlerNsisShortcutDesktop>
    <BundlerNsisShortcutStartMenu Condition="'$(BundlerNsisShortcutStartMenu)' == ''">true</BundlerNsisShortcutStartMenu>
    <BundlerNsisShortcutArguments>$(BundlerIntegrationShortcutArguments)</BundlerNsisShortcutArguments>
    <BundlerNsisShortcutWorkingDirectory>docs</BundlerNsisShortcutWorkingDirectory>
    <BundlerNsisShortcutIcon>BundlerIntegrationFixture.exe</BundlerNsisShortcutIcon>
    <BundlerNsisShortcutAppUserModelId>com.dotnetbundler.integrationfixture.desktop</BundlerNsisShortcutAppUserModelId>
    <BundlerNsisShortcutStartMenuFolder>$(BundlerIntegrationShortcutStartMenuFolder)</BundlerNsisShortcutStartMenuFolder>
    <BundlerNsisShortcutLegacyProductNames>Legacy Bundler Fixture</BundlerNsisShortcutLegacyProductNames>
    <BundlerNsisShortcutLegacyMainExecutables>LegacyFixture.exe</BundlerNsisShortcutLegacyMainExecutables>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="$(BundlerIntegrationPackageId)" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerIcon Include="$(BundlerTestIcon)" Condition="'$(BundlerTestIcon)' != ''" />
    <BundlerResource Include="Assets\license.txt" TargetPath="docs\license.txt" />
    <BundlerFileAssociation Include="dbfixture"
                            Name="DotNet.Bundler fixture document"
                            Description="Disposable DotNet.Bundler integration fixture document"
                            MimeType="application/x-dotnet-bundler-fixture" />
    <BundlerUrlProtocol Include="bundlerfixture" Name="DotNet.Bundler fixture link" />
  </ItemGroup>
</Project>
