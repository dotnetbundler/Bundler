<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <BundlerTarget Condition="'$(Target)' == ''">macos-arm64</BundlerTarget>
    <SelfContained>true</SelfContained>
    <AssemblyName>BundlerMacIntegrationFixture</AssemblyName>
    <Version>1.0.0</Version>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerIntegrationIdentifier Condition="'$(BundlerIntegrationIdentifier)' == ''">com.dotnetbundler.macintegrationfixture</BundlerIntegrationIdentifier>
    <BundlerIntegrationProductName Condition="'$(BundlerIntegrationProductName)' == ''">Bundler Mac Integration Fixture</BundlerIntegrationProductName>
    <BundlerFormats>app</BundlerFormats>
    <BundlerIdentifier>$(BundlerIntegrationIdentifier)</BundlerIdentifier>
    <BundlerProductName>$(BundlerIntegrationProductName)</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Tests</BundlerPublisher>
    <BundlerDescription>Disposable macOS .app integration-test fixture.</BundlerDescription>
    <BundlerCopyright>Copyright DotNet.Bundler Tests</BundlerCopyright>
    <BundlerOutputPath>$(BundlerIntegrationOutput)</BundlerOutputPath>
    <BundlerMacAppPackageName>MacFixture</BundlerMacAppPackageName>
    <BundlerMacAppDisplayName>Bundler Mac Fixture</BundlerMacAppDisplayName>
    <BundlerMacAppBuildVersion Condition="'$(BundlerTestBuildVersion)' == ''">2026.9.1</BundlerMacAppBuildVersion>
    <BundlerMacAppBuildVersion Condition="'$(BundlerTestBuildVersion)' != ''">$(BundlerTestBuildVersion)</BundlerMacAppBuildVersion>
    <BundlerMacAppMinimumSystemVersion Condition="'$(BundlerTestMinSystemVersion)' == ''">11.0</BundlerMacAppMinimumSystemVersion>
    <BundlerMacAppMinimumSystemVersion Condition="'$(BundlerTestMinSystemVersion)' != ''">$(BundlerTestMinSystemVersion)</BundlerMacAppMinimumSystemVersion>
    <BundlerMacAppCategory>public.app-category.utilities</BundlerMacAppCategory>
    <BundlerMacAppIconName>FixtureIcon</BundlerMacAppIconName>
    <BundlerMacAppExceptionDomain>bundler.invalid</BundlerMacAppExceptionDomain>
    <BundlerMacAppInfoPlistFile Condition="'$(BundlerTestInfoPlistFile)' == ''">$(MSBuildThisFileDirectory)extra.plist</BundlerMacAppInfoPlistFile>
    <BundlerMacAppInfoPlistFile Condition="'$(BundlerTestInfoPlistFile)' != ''">$(BundlerTestInfoPlistFile)</BundlerMacAppInfoPlistFile>
    <BundlerMacAppSignIdentity Condition="'$(BundlerTestSignIdentity)' != ''">$(BundlerTestSignIdentity)</BundlerMacAppSignIdentity>
    <BundlerMacAppHardenedRuntime Condition="'$(BundlerTestHardenedRuntime)' != ''">$(BundlerTestHardenedRuntime)</BundlerMacAppHardenedRuntime>
    <BundlerMacAppEntitlementsFile Condition="'$(BundlerTestEntitlementsFile)' != ''">$(BundlerTestEntitlementsFile)</BundlerMacAppEntitlementsFile>
    <BundlerMacAppTemporaryCertificateFile Condition="'$(BundlerTestSigningCertificate)' != ''">$(BundlerTestSigningCertificate)</BundlerMacAppTemporaryCertificateFile>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.ProjectReference.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <BundlerIcon Include="$(BundlerTestIconFile)" Condition="'$(BundlerTestIconFile)' != ''" />
    <BundlerResource Include="Assets/readme.txt" Destination="docs/readme.txt" />
    <BundlerFileAssociation Include="hifix" Name="HiFix Document" Description="Integration fixture document" MimeType="application/x-hifix" />
    <BundlerUrlProtocol Include="hifix" Name="HiFix Link" />
    <BundlerMacDocumentType Include="hifix" Rank="Owner" ExportedTypeIdentifier="com.dotnetbundler.hifix" ExportedTypeConformsTo="public.data" />
    <BundlerMacUrlType Include="hifix" Role="Viewer" />
    <BundlerMacAppFile Include="Assets/shared.txt" Destination="SharedSupport/shared.txt" />
    <BundlerMacAppFrameworkDirectory Include="$(BundlerTestDylib)" Condition="'$(BundlerTestDylib)' != ''" />
  </ItemGroup>
</Project>
