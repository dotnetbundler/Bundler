<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>BundlerDebIntegrationFixture</AssemblyName>
    <Version>1.0.0</Version>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>deb</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.debintegrationfixture</BundlerIdentifier>
    <BundlerProductName>Bundler Deb Fixture</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Tests</BundlerPublisher>
    <BundlerDescription>Disposable .deb integration-test fixture.</BundlerDescription>
    <BundlerHomepage>https://example.com/deb-fixture</BundlerHomepage>
    <BundlerOutputPath>$(BundlerIntegrationOutput)</BundlerOutputPath>
    <BundlerDebPackageName Condition="'$(BundlerTestDebPackageName)' != ''">$(BundlerTestDebPackageName)</BundlerDebPackageName>
    <BundlerDebVersion Condition="'$(BundlerTestDebVersion)' != ''">$(BundlerTestDebVersion)</BundlerDebVersion>
    <BundlerDebRevision Condition="'$(BundlerTestDebRevision)' != ''">$(BundlerTestDebRevision)</BundlerDebRevision>
    <BundlerDebEpoch Condition="'$(BundlerTestDebEpoch)' != ''">$(BundlerTestDebEpoch)</BundlerDebEpoch>
    <BundlerDebArchitecture Condition="'$(BundlerTestDebArchitecture)' != ''">$(BundlerTestDebArchitecture)</BundlerDebArchitecture>
    <BundlerDebMaintainer Condition="'$(BundlerTestDebMaintainer)' != ''">$(BundlerTestDebMaintainer)</BundlerDebMaintainer>
    <BundlerDebInstallRoot Condition="'$(BundlerTestDebInstallRoot)' != ''">$(BundlerTestDebInstallRoot)</BundlerDebInstallRoot>
    <BundlerDebBinLink Condition="'$(BundlerTestDebBinLink)' != ''">$(BundlerTestDebBinLink)</BundlerDebBinLink>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
  </ItemGroup>
</Project>
