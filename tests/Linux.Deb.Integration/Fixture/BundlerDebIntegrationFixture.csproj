<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>BundlerDebIntegrationFixture</AssemblyName>
    <Version>1.0.0</Version>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>deb</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.debintegrationfixture</BundlerIdentifier>
    <BundlerProductName>Bundler Deb Fixture</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Tests</BundlerPublisher>
    <BundlerDebMaintainer>DotNet.Bundler Tests &lt;tests@example.com&gt;</BundlerDebMaintainer>
    <BundlerDebSection>utils</BundlerDebSection>
    <BundlerDescription>Disposable .deb integration-test fixture.</BundlerDescription>
    <BundlerHomepage>https://example.com/deb-fixture</BundlerHomepage>
    <BundlerOutputPath>$(BundlerIntegrationOutput)</BundlerOutputPath>
    <BundlerDebPackageName Condition="'$(BundlerTestDebPackageName)' != ''">$(BundlerTestDebPackageName)</BundlerDebPackageName>
    <BundlerDebVersion Condition="'$(BundlerTestDebVersion)' != ''">$(BundlerTestDebVersion)</BundlerDebVersion>
    <BundlerDebRevision Condition="'$(BundlerTestDebRevision)' != ''">$(BundlerTestDebRevision)</BundlerDebRevision>
    <BundlerDebEpoch Condition="'$(BundlerTestDebEpoch)' != ''">$(BundlerTestDebEpoch)</BundlerDebEpoch>
    <BundlerDebArchitecture Condition="'$(BundlerTestDebArchitecture)' != ''">$(BundlerTestDebArchitecture)</BundlerDebArchitecture>
    <BundlerDebMaintainer Condition="'$(BundlerTestDebMaintainer)' != ''">$(BundlerTestDebMaintainer)</BundlerDebMaintainer>
    <BundlerDebInstallRoot Condition="'$(BundlerTestDebInstallRoot)' != ''">$(BundlerTestDebInstallRoot)</BundlerDebInstallRoot>
    <BundlerDebBinLink Condition="'$(BundlerTestDebBinLink)' != ''">$(BundlerTestDebBinLink)</BundlerDebBinLink>
    <BundlerDebDepends Condition="'$(BundlerTestDebDepends)' != ''">$(BundlerTestDebDepends)</BundlerDebDepends>
    <BundlerDebRecommends Condition="'$(BundlerTestDebRecommends)' != ''">$(BundlerTestDebRecommends)</BundlerDebRecommends>
    <BundlerDebProvides Condition="'$(BundlerTestDebProvides)' != ''">$(BundlerTestDebProvides)</BundlerDebProvides>
    <BundlerDebConflicts Condition="'$(BundlerTestDebConflicts)' != ''">$(BundlerTestDebConflicts)</BundlerDebConflicts>
    <BundlerDebReplaces Condition="'$(BundlerTestDebReplaces)' != ''">$(BundlerTestDebReplaces)</BundlerDebReplaces>
    <BundlerDebSection Condition="'$(BundlerTestDebSection)' != ''">$(BundlerTestDebSection)</BundlerDebSection>
    <BundlerDebPriority Condition="'$(BundlerTestDebPriority)' != ''">$(BundlerTestDebPriority)</BundlerDebPriority>
    <BundlerDebCategories>Utility;Development</BundlerDebCategories>
    <BundlerDebCategories Condition="'$(BundlerTestDebCategories)' != ''">$(BundlerTestDebCategories)</BundlerDebCategories>
    <BundlerDebDesktopFile Condition="'$(BundlerTestDebDesktopFile)' != ''">$(BundlerTestDebDesktopFile)</BundlerDebDesktopFile>
    <BundlerDebMetainfoFile Condition="'$(BundlerTestDebSkipMetainfo)' != 'true'">$(MSBuildThisFileDirectory)Assets/app.metainfo.xml</BundlerDebMetainfoFile>
    <BundlerDebMetainfoFile Condition="'$(BundlerTestDebMetainfoFile)' != ''">$(BundlerTestDebMetainfoFile)</BundlerDebMetainfoFile>
    <BundlerDebChangelogFile>$(MSBuildThisFileDirectory)Assets/CHANGELOG.md</BundlerDebChangelogFile>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets/LICENSE.txt</BundlerLicenseFile>
    <BundlerDebPreinstFile Condition="'$(BundlerTestDebPreinstFile)' != ''">$(BundlerTestDebPreinstFile)</BundlerDebPreinstFile>
    <BundlerDebPostinstFile Condition="'$(BundlerTestDebPostinstFile)' != ''">$(BundlerTestDebPostinstFile)</BundlerDebPostinstFile>
    <BundlerDebPrermFile Condition="'$(BundlerTestDebPrermFile)' != ''">$(BundlerTestDebPrermFile)</BundlerDebPrermFile>
    <BundlerDebPostrmFile Condition="'$(BundlerTestDebPostrmFile)' != ''">$(BundlerTestDebPostrmFile)</BundlerDebPostrmFile>
    <BundlerDebSystemdServiceFile Condition="'$(BundlerTestDebSystemdServiceFile)' != ''">$(BundlerTestDebSystemdServiceFile)</BundlerDebSystemdServiceFile>
    <BundlerDebConffiles Condition="'$(BundlerTestDebConffiles)' != ''">$(BundlerTestDebConffiles)</BundlerDebConffiles>
    <BundlerDebCompression Condition="'$(BundlerTestDebCompression)' != ''">$(BundlerTestDebCompression)</BundlerDebCompression>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
    <BundlerIcon Include="Assets/icon48.png" />
    <BundlerIcon Include="Assets/icon@2x.png" />
    <BundlerFileAssociation Include=".bdlfixture" Name="Bundler fixture document"
        MimeType="application/x-bundler-fixture" />
    <BundlerUrlProtocol Include="bdlfixture" Name="Bundler fixture" />
    <BundlerDebFile Include="Assets/defaults.conf" Destination="/etc/bundler-deb-fixture/defaults.conf" />
  </ItemGroup>
</Project>
