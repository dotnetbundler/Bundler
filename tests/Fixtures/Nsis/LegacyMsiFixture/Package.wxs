<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Bundler Integration Fixture"
           Manufacturer="DotNet.Bundler Tests"
           Version="0.9.0"
           ProductCode="{1D1A6B03-2BDA-4D18-B12C-574145D9CFA0}"
           UpgradeCode="{5AD89AE2-9984-4B5F-937F-0DF918FE7A22}"
           UpgradeStrategy="none"
           Scope="perUser">
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Bundler Legacy MSI Fixture">
        <Component Id="LegacyPayloadComponent" Guid="{924486A9-FA81-4C8F-BFA9-50821306C70B}">
          <File Id="LegacyPayloadFile" Source="legacy-payload.txt" />
          <RegistryValue Root="HKCU"
                         Key="Software\DotNet.Bundler\LegacyMsiFixture"
                         Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature">
      <ComponentRef Id="LegacyPayloadComponent" />
    </Feature>
  </Package>
</Wix>
