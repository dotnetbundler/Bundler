<Project Sdk="Microsoft.NET.Sdk">
  <!-- 仓外独立包消费验收模板：被 MsiIntegrationTests 复制到仓库之外，
       模拟外部用户通过 NuGet 包消费后端。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler.Wix" VersionOverride="$(BundlerPackageVersion)" />
  </ItemGroup>
</Project>
