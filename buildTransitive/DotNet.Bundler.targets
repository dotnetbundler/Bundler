<Project>
  <PropertyGroup>
    <_BundlerPackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</_BundlerPackageRoot>
    <_BundlerDriver>$(_BundlerPackageRoot)tools\net8.0\any\bundler.dll</_BundlerDriver>
    <_BundlerTaskAssembly>$(_BundlerPackageRoot)tasks\netstandard2.0\DotNet.Bundler.MSBuild.dll</_BundlerTaskAssembly>
    <_BundlerNsisArchive>$(_BundlerPackageRoot)tools\nsis\nsis-3.12.zip</_BundlerNsisArchive>
    <_BundlerDefaultNsisTemplate>$(_BundlerPackageRoot)templates\nsis\installer.nsi</_BundlerDefaultNsisTemplate>
  </PropertyGroup>

  <UsingTask TaskName="DotNet.Bundler.MSBuild.BundleDesktopApplication"
             AssemblyFile="$(_BundlerTaskAssembly)" />

  <Target Name="BundleDesktopApplication"
          AfterTargets="Publish"
          Condition="'$(BundlerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BundlerProductName Condition="'$(BundlerProductName)' == ''">$(AssemblyName)</BundlerProductName>
      <BundlerVersion Condition="'$(BundlerVersion)' == ''">$(Version)</BundlerVersion>
      <BundlerMainExecutable Condition="'$(BundlerMainExecutable)' == ''">$(TargetName).exe</BundlerMainExecutable>
      <BundlerNsisTemplate Condition="'$(BundlerNsisTemplate)' == ''">$(_BundlerDefaultNsisTemplate)</BundlerNsisTemplate>
    </PropertyGroup>
    <Error Condition="'$(BundlerIdentifier)' == ''"
           Text="BundlerIdentifier is required when BundlerEnabled is true." />
    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="RuntimeIdentifier is required when BundlerEnabled is true." />
    <Error Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
           Text="The first Bundler release supports Windows RIDs only." />
    <Error Condition="'$(BundlerFormat)' != 'nsis'"
           Text="The first Bundler release supports the nsis format only." />

    <Message Importance="high" Text="Bundling $(BundlerProductName) for $(RuntimeIdentifier) as NSIS..." />
    <DotNet.Bundler.MSBuild.BundleDesktopApplication
      DriverPath="$(_BundlerDriver)"
      ProductName="$(BundlerProductName)"
      Identifier="$(BundlerIdentifier)"
      Version="$(BundlerVersion)"
      Publisher="$(BundlerPublisher)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      InputDirectory="$(PublishDir)"
      OutputDirectory="$(BundlerOutputPath)"
      MainExecutable="$(BundlerMainExecutable)"
      Format="$(BundlerFormat)"
      ToolArchivePath="$(_BundlerNsisArchive)"
      ToolCacheDirectory="$(BundlerToolCachePath)"
      TemplatePath="$(BundlerNsisTemplate)"
      IntermediateDirectory="$(IntermediateOutputPath)bundler" />
  </Target>
</Project>
