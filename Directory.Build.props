<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BundlerPackageVersion>0.1.0-alpha.109</BundlerPackageVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- NuGet Audit（SDK10 默认 mode=all）每次 restore 向每个 HTTP 源拉漏洞
         数据——包全在本地缓存也照发，是共享 runner 断供窗口内的固定挂死点
         （CI 实证，见 tests/Shared/Tooling/Dotnet.cs 头注）；本仓是打包工具
         非部署应用，NU190x 审计告警无运营价值，全仓关掉。仓库外复制的
         fixture 工程够不到本 props，由 RestoreWithRetry 另行 -p 注入。 -->
    <NuGetAudit>false</NuGetAudit>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
