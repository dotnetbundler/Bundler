<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DotNet.Bundler.Signing.Windows</AssemblyName>
    <RootNamespace>DotNet.Bundler.Signing.Windows</RootNamespace>
    <PackageId>DotNet.Bundler.Signing.Windows</PackageId>
    <PackageVersion>$(BundlerPackageVersion)</PackageVersion>
    <Authors>Bundler contributors</Authors>
    <Description>Reusable Windows Authenticode signing API for DotNet.Bundler and other .NET tools.</Description>
    <PackageTags>dotnet;authenticode;signing;windows;installer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bundler.Abstractions\Bundler.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
