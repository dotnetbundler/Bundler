<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DotNet.Bundler.AlpineApk</AssemblyName>
    <RootNamespace>DotNet.Bundler.AlpineApk</RootNamespace>
    <PackageId>DotNet.Bundler.AlpineApk</PackageId>
    <Description>Reusable Alpine .apk package writer for desktop applications (pure managed, no host tools).</Description>
    <PackageTags>dotnet;bundler;linux;alpine;apk;musl;installer;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.Tests" />
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
