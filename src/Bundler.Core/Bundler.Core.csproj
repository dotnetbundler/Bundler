<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>DotNet.Bundler.Core</AssemblyName>
    <RootNamespace>DotNet.Bundler.Core</RootNamespace>
    <PackageId>DotNet.Bundler.Core</PackageId>
    <Description>Format-neutral validation, planning, orchestration, and tool caching for desktop packages.</Description>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Configuration\BundleConfigurationLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bundler.Abstractions\Bundler.Abstractions.csproj" />
    <!-- 引导件内嵌：任何消费形态（MSBuild 包/CLI/项目直引/NuGet）都能为载荷选件，
         无需盘符约定；UpdateBootstrapper 经清单资源名 updater/<rid>/ 解析。
         RecursiveDir 按宿主目录分隔符展开（Windows 为 '\'）——逻辑名归一 '\'→'/'，
         保证资源名与构建机无关。 -->
    <EmbeddedResource Include="..\Bundler.Updater.Bootstrap\tools\**">
      <LogicalName>$([System.String]::Copy('updater/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
