<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DotNet.Bundler.MSBuild</AssemblyName>
    <RootNamespace>DotNet.Bundler.MSBuild</RootNamespace>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <PackageId>DotNet.Bundler</PackageId>
    <PackageVersion>$(BundlerPackageVersion)</PackageVersion>
    <Authors>Bundler contributors</Authors>
    <Description>Automatic desktop installer generation for published .NET applications.</Description>
    <PackageTags>dotnet;msbuild;bundler;installer;nsis;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
    <ProjectReference Include="..\Bundler.Nsis\Bundler.Nsis.csproj" />
    <PackageReference Include="Microsoft.Build.Utilities.Core"
                      Version="17.8.43"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="$(TargetDir)DotNet.Bundler.MSBuild.deps.json" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="$(TargetDir)Bundler.Core.dll" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="$(TargetDir)DotNet.Bundler.Nsis.dll" Pack="true" PackagePath="tasks/netstandard2.0/" />
    <None Include="..\..\buildTransitive\DotNet.Bundler.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="..\..\buildTransitive\DotNet.Bundler.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
