<Project>
  <PropertyGroup>
    <_BundlerPackageRoot Condition="'$(_BundlerPackageRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</_BundlerPackageRoot>
    <_BundlerTaskAssembly Condition="'$(_BundlerTaskAssembly)' == ''">$(_BundlerPackageRoot)tasks\netstandard2.0\DotNet.Bundler.MSBuild.dll</_BundlerTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="DotNet.Bundler.MSBuild.BundleDesktopApplication"
             AssemblyFile="$(_BundlerTaskAssembly)" />
  <UsingTask TaskName="DotNet.Bundler.MSBuild.MergeUniversalPayload"
             AssemblyFile="$(_BundlerTaskAssembly)" />

  <!-- bundler target ↔ canonical publish RID 双向映射表：
       BundlerBundle 自动发布按 BundlerTarget→Rid 查 canonical RID；
       BundlerTarget 缺省时按 Rid→target 从 $(RuntimeIdentifier) 便捷推导（显式 BundlerTarget 恒覆盖）。
       macos-universal 无单一 canonical RID——走 BundlerUniversalTargets 双 RID 内层发布+合并路。
       边界：映射只解决“该用哪个 RID 发布载荷”，可发布≠可打包——target 对某格式是否受
       支持仍由 Core 的格式×平台矩阵裁决（如 linux-i686 可发布但只有部分格式支持）。 -->
  <ItemGroup>
    <_BundlerRidMap Include="windows-x86_64"><Rid>win-x64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="windows-i686"><Rid>win-x86</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="windows-arm64"><Rid>win-arm64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="macos-x86_64"><Rid>osx-x64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="macos-arm64"><Rid>osx-arm64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="linux-x86_64"><Rid>linux-x64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="linux-i686"><Rid>linux-x86</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="linux-aarch64"><Rid>linux-arm64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="linux-musl-x86_64"><Rid>linux-musl-x64</Rid></_BundlerRidMap>
    <_BundlerRidMap Include="linux-musl-aarch64"><Rid>linux-musl-arm64</Rid></_BundlerRidMap>
  </ItemGroup>

  <!-- 两入口依赖链（依赖 target 的属性改动对后续依赖和被依赖方可见；不能用 CallTarget——
       被调方拿不到调用方体内设置的属性）。
       $(PublishDir) 是计算属性永远非空，不能当“本次跑过 Publish”的信号——
       所以钩子链没有 _BundlerAutoPublish：钩子入口天然跟在真实 Publish 后，输入即 $(PublishDir)。 -->
  <PropertyGroup>
    <_BundlerStages>_BundlerDerive;_BundlerPublishMismatchWarn;_BundlerUniversalMerge;_BundlerBundleCore</_BundlerStages>
    <_BundlerBundleStages>_BundlerDerive;_BundlerUniversalMerge;_BundlerAutoPublish;_BundlerBundleCore</_BundlerBundleStages>
  </PropertyGroup>

  <!-- Publish 钩子入口：dotnet publish 时顺带打包（BundlerEnabled=true 才挂） -->
  <Target Name="BundleDesktopApplication"
          AfterTargets="Publish"
          DependsOnTargets="$(_BundlerStages)"
          Condition="'$(BundlerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'" />

  <!-- 显式入口（不经 Publish 钩子也可调用）：
       -p:BundlerInputDir=<dir> → 拿已发布目录直接打包，不触发发布
       无 BundlerInputDir       → 按 BundlerTarget→canonical RID（可用 -p:BundlerPublishRid 覆盖）内部 dotnet publish 到 obj/BundlerPublish/<target>/ 再打包
       BundlerUniversalTargets  → macOS universal 双 RID 内层发布+合并 -->
  <Target Name="BundlerBundle"
          DependsOnTargets="$(_BundlerBundleStages)"
          Condition="'$(DesignTimeBuild)' != 'true'" />

  <!-- 阶段1：BundlerTarget 推导（Rid→target 便捷推导，显式 BundlerTarget 恒覆盖）+ 入口参数校验 -->
  <Target Name="_BundlerDerive">
    <ItemGroup>
      <_BundlerTargetFromRid Include="@(_BundlerRidMap->'%(Identity)')"
          Condition="'%(_BundlerRidMap.Rid)' == '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <PropertyGroup>
      <BundlerTarget Condition="'$(BundlerTarget)' == ''">@(_BundlerTargetFromRid)</BundlerTarget>
      <!-- RID 在 eval 后变更时刷新我们自己的推导（判据：props 前显式为空且当前值==eval 推导值）；
           显式 BundlerTarget 恒不动；刷新动作警告可见——若该值其实是 csproj 体内的显式设置且恰与
           旧推导值相同（无法区分），-p:BundlerTarget= 全局钉死即可不误伤 -->
      <_BundlerTargetStale Condition="'$(BundlerTarget)' == '$(_BundlerEvalTarget)' and '$(_BundlerEvalTarget)' != '' and '@(_BundlerTargetFromRid)' != '' and '$(BundlerTarget)' != '@(_BundlerTargetFromRid)'">true</_BundlerTargetStale>
      <BundlerTarget Condition="'$(_BundlerTargetStale)' == 'true'">@(_BundlerTargetFromRid)</BundlerTarget>
    </PropertyGroup>
    <Warning Condition="'$(_BundlerTargetStale)' == 'true'"
             Text="BundlerTarget was derived from a stale RuntimeIdentifier and was refreshed to '@(_BundlerTargetFromRid)'. Pass -p:BundlerTarget=&lt;target&gt; to pin it explicitly." />
    <PropertyGroup>
      <BundlerFormats Condition="'$(BundlerFormats)' == ''">nsis</BundlerFormats>
      <_BundlerPublishOutDir>$(IntermediateOutputPath)BundlerPublish\$(BundlerTarget)\</_BundlerPublishOutDir>
    </PropertyGroup>
    <Error Condition="'$(BundlerIdentifier)' == ''"
           Text="BundlerIdentifier is required to bundle." />
    <Error Condition="'$(BundlerTarget)' == '' and '$(BundlerUniversalTargets)' == ''"
           Text="BundlerTarget is required to bundle (pass -p:BundlerTarget=&lt;target&gt;, or -p:RuntimeIdentifier=&lt;rid&gt; for table derivation)." />
    <Error Condition="'$(BundlerInputDir)' != '' and '$(BundlerUniversalTargets)' != ''"
           Text="BundlerInputDir cannot be combined with BundlerUniversalTargets." />
  </Target>

  <!-- 钩子链专属警告：显式 BundlerTarget 与发布 RID 推导值冲突（payload 平台≠包标签）。
       只警告不改值——显式恒胜。只在钩子链：显式 BundlerBundle 路的 inner publish 用
       BundlerPublishRid 覆盖项目 RID，target 与项目 RID 不符是预期；universal/InputDir 同。 -->
  <Target Name="_BundlerPublishMismatchWarn">
    <Warning Condition="'$(_BundlerTargetStale)' != 'true' and '$(BundlerTarget)' != '' and '@(_BundlerTargetFromRid)' != '' and '$(BundlerTarget)' != '@(_BundlerTargetFromRid)' and '$(BundlerInputDir)' == '' and '$(BundlerUniversalTargets)' == ''"
             Text="BundlerTarget '$(BundlerTarget)' does not match the target '@(_BundlerTargetFromRid)' mapped from RuntimeIdentifier '$(RuntimeIdentifier)'. The explicit target wins; remove BundlerTarget to derive from the RID." />
  </Target>

  <!-- macOS universal 输入解析：per-RID 内层发布 + 托管合并（两入口共用；BundlerUniversalTargets 未设时跳过） -->
  <Target Name="_BundlerUniversalMerge" Condition="'$(BundlerUniversalTargets)' != ''">
    <PropertyGroup>
      <_BundlerUniversalDir>$(IntermediateOutputPath)BundlerUniversal\</_BundlerUniversalDir>
      <_BundlerEffectiveTarget>macos-universal</_BundlerEffectiveTarget>
    </PropertyGroup>
    <ItemGroup>
      <!-- 命令行只能传 %3B 形式：-p: 的 ; 和 , 都是 CLI 级分隔符（直接炸 MSB1006），
           %3B 在属性里保留字面量——[MSBuild]::Unescape 解码后建项；csproj 里的真 ; 不受影响。 -->
      <_BundlerUniversalRid Include="$([MSBuild]::Unescape('$(BundlerUniversalTargets)'))" />
      <!-- Flag any RID that is not an osx-* identifier or carries path/shell content; identities are
           interpolated into the inner publish -o path and the shell command line. -->
      <_BundlerUniversalRidBad Include="@(_BundlerUniversalRid)"
          Condition="$([System.String]::Copy('%(_BundlerUniversalRid.Identity)').StartsWith('osx-')) != 'true'
            or $([System.String]::Copy('%(_BundlerUniversalRid.Identity)').Contains('..'))
            or $([System.String]::Copy('%(_BundlerUniversalRid.Identity)').Contains(';'))
            or $([System.String]::Copy('%(_BundlerUniversalRid.Identity)').Contains('&quot;'))
            or $([System.IO.Path]::GetFileName('%(_BundlerUniversalRid.Identity)')) != '%(_BundlerUniversalRid.Identity)'" />
    </ItemGroup>
    <Error Condition="'@(_BundlerUniversalRidBad)' != ''"
           Text="BundlerUniversalTargets only accepts plain osx-* runtime identifiers (got '@(_BundlerUniversalRidBad)')." />
    <!-- Clean stale per-RID and merged outputs: publish -o does not remove files deleted since a previous run. -->
    <RemoveDir Directories="@(_BundlerUniversalRid -> '$(_BundlerUniversalDir)%(Identity)');$(_BundlerUniversalDir)merged;$(_BundlerUniversalDir)reference" />
    <!-- universal 需要 framework-dependent 发布：RID-less 参考构建产非 Mach-O 权威源，
         SelfContained/AOT/单文件强绑 RID，在此提前给出明确报错而不是怪异的 SDK 失败。 -->
    <Error Condition="'$(BundlerUniversalTargets)' != '' and ('$(SelfContained)' == 'true' or '$(PublishAot)' == 'true' or '$(PublishSingleFile)' == 'true')"
           Text="BundlerUniversalTargets requires a framework-dependent, non-single-file publish; SelfContained/PublishAot/PublishSingleFile cannot be merged into a universal payload." />
    <!-- MSBuild 子构建内层发布：子构建自动继承调用方全部全局属性（PublishSingleFile/SelfContained/
         PublishAot 等发布选项不丢），Properties 只覆盖 RID/输出目录/BundlerEnabled 防钩子递归；
         子构建无 CLI 隐式 restore——每个 RID 在单个子构建里 Restore;Publish 连跑：assets 重写
         只留当前 RID 也不怕（即刻消费），而 RuntimeIdentifiers 多 RID 合图会被
         _GenerateRestoreGraphProjectEntry 当单个 RID 校验（NETSDK1083），走不通。
         TargetFramework 不入 Properties：子构建评的是同一个工程自己解 TFM；全局传入会沿
         ProjectReference 恢复链污染异 TFM 引用（如 netstandard2.0 任务工程的 assets）。 -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Publish"
             Properties="RuntimeIdentifier=%(_BundlerUniversalRid.Identity);PublishDir=$(_BundlerUniversalDir)%(_BundlerUniversalRid.Identity);BundlerEnabled=false" />
    <!-- 无 RID 参考发布：非 Mach-O 文件的权威源。RID 专属构建给托管件打架构印记（PE machine
         及派生 MVID/时间戳），两 arch 的 test.dll 天然逐字节相异、无法靠比对合并；参考发布
         以中性构建提供同源 managed 载荷。要求工程可无 RID 发布——SelfContained/AOT 等强绑
         RID 的配置在此自然报错（universal 也无法表达逐 arch 运行时差异）。 -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Publish"
             Properties="RuntimeIdentifier=;PublishDir=$(_BundlerUniversalDir)reference;BundlerEnabled=false" />
    <DotNet.Bundler.MSBuild.MergeUniversalPayload
      SourceDirectories="@(_BundlerUniversalRid -> '$(_BundlerUniversalDir)%(Identity)')"
      ReferenceDirectory="$(_BundlerUniversalDir)reference"
      OutputDirectory="$(_BundlerUniversalDir)merged">
      <Output TaskParameter="MergedDirectory" PropertyName="_BundlerEffectiveInput" />
    </DotNet.Bundler.MSBuild.MergeUniversalPayload>
  </Target>

  <!-- 阶段3：显式 BundlerBundle 的自动发布腿（只在显���链）——无输入目录且非 universal 时按 canonical RID 内层发布 -->
  <Target Name="_BundlerAutoPublish"
          Condition="'$(BundlerInputDir)' == '' and '$(BundlerUniversalTargets)' == ''">
    <ItemGroup>
      <_BundlerPublishRidFromMap Include="@(_BundlerRidMap->'%(Rid)')"
          Condition="'%(_BundlerRidMap.Identity)' == '$(BundlerTarget)'" />
    </ItemGroup>
    <PropertyGroup>
      <BundlerPublishRid Condition="'$(BundlerPublishRid)' == ''">@(_BundlerPublishRidFromMap)</BundlerPublishRid>
      <_BundlerEffectiveInput>$(_BundlerPublishOutDir)</_BundlerEffectiveInput>
    </PropertyGroup>
    <Error Condition="'$(BundlerPublishRid)' == ''"
           Text="BundlerTarget '$(BundlerTarget)' has no canonical publish RID mapping — pass -p:BundlerPublishRid=&lt;rid&gt; or -p:BundlerInputDir=&lt;dir&gt;." />
    <!-- publish -o 不清理上次构建已删的文件——先清中间发布目录防滞留 -->
    <RemoveDir Directories="$(_BundlerPublishOutDir)" />
    <!-- 子构建无 CLI 隐式 restore——先跑 Restore 腿下载该 RID 运行时包（TFM 不传，见 universal 段注释） -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore"
             Properties="RuntimeIdentifier=$(BundlerPublishRid)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish"
             Properties="RuntimeIdentifier=$(BundlerPublishRid);PublishDir=$(_BundlerPublishOutDir);BundlerEnabled=false" />
  </Target>

  <!-- 共享打包体：effective 输入/目标归一 → 默认值推导 → 任务调用 -->
  <Target Name="_BundlerBundleCore">
    <PropertyGroup>
      <!-- universal 腿在 _BundlerUniversalMerge 已设两个 effective；其余优先级：BundlerInputDir > $(PublishDir)（本次已发布）> 内层发布目录 -->
      <_BundlerEffectiveInput Condition="'$(_BundlerEffectiveInput)' == '' and '$(BundlerInputDir)' != ''">$(BundlerInputDir)</_BundlerEffectiveInput>
      <_BundlerEffectiveInput Condition="'$(_BundlerEffectiveInput)' == '' and '$(PublishDir)' != ''">$(PublishDir)</_BundlerEffectiveInput>
      <_BundlerEffectiveInput Condition="'$(_BundlerEffectiveInput)' == ''">$(_BundlerPublishOutDir)</_BundlerEffectiveInput>
      <_BundlerEffectiveTarget Condition="'$(_BundlerEffectiveTarget)' == ''">$(BundlerTarget)</_BundlerEffectiveTarget>
      <BundlerProductName Condition="'$(BundlerProductName)' == ''">$(AssemblyName)</BundlerProductName>
      <BundlerProductName Condition="'$(BundlerProductName)' == ''">$(AssemblyName)</BundlerProductName>
      <BundlerVersion Condition="'$(BundlerVersion)' == ''">$(Version)</BundlerVersion>
      <BundlerMainExecutable Condition="'$(BundlerMainExecutable)' == '' and ($([System.String]::Copy('$(BundlerTarget)').StartsWith('macos-')) == 'true' or $([System.String]::Copy('$(BundlerTarget)').StartsWith('linux-')) == 'true' or '$(BundlerTarget)' == 'macos-universal' or '$(BundlerUniversalTargets)' != '')">$(TargetName)</BundlerMainExecutable>
      <BundlerMainExecutable Condition="'$(BundlerMainExecutable)' == ''">$(TargetName).exe</BundlerMainExecutable>
      <BundlerNsisShortcutStartMenuFolder Condition="'$(BundlerNsisShortcutStartMenuFolder)' == ''">$(BundlerProductName)</BundlerNsisShortcutStartMenuFolder>
    </PropertyGroup>
    <Message Importance="high" Text="Bundling $(BundlerProductName) for $(_BundlerEffectiveTarget): $(BundlerFormats)..." />
    <DotNet.Bundler.MSBuild.BundleDesktopApplication
      ProductName="$(BundlerProductName)"
      Identifier="$(BundlerIdentifier)"
      Version="$(BundlerVersion)"
      Publisher="$(BundlerPublisher)"
      Description="$(BundlerDescription)"
      Homepage="$(BundlerHomepage)"
      Copyright="$(BundlerCopyright)"
      LicenseFile="$(BundlerLicenseFile)"
      BundlerTarget="$(_BundlerEffectiveTarget)"
      InputDirectory="$(_BundlerEffectiveInput)"
      OutputDirectory="$(BundlerOutputPath)"
      OutputLayout="$(BundlerOutputLayout)"
      MainExecutable="$(BundlerMainExecutable)"
      Formats="$(BundlerFormats)"
      Icons="@(BundlerIcon)"
      Resources="@(BundlerResource)"
      FileAssociations="@(BundlerFileAssociation)"
      UrlProtocols="@(BundlerUrlProtocol)"
      WindowsSigningFiles="@(BundlerWindowsSigningFile)"
      NsisToolsetArchivePath="$(BundlerNsisToolsetArchivePath)"
      NsisCompilerPath="$(BundlerNsisCompilerPath)"
      NsisDataDirectory="$(BundlerNsisDataDirectory)"
      ToolCacheDirectory="$(BundlerToolCachePath)"
      WixToolsetArchivePath="$(BundlerWixToolsetArchivePath)"
      WixInstallScope="$(BundlerWixInstallScope)"
      WixUpgradeCode="$(BundlerWixUpgradeCode)"
      WixVersion="$(BundlerWixVersion)"
      WixAllowDowngrades="$(BundlerWixAllowDowngrades)"
      WixCodepage="$(BundlerWixCodepage)"
      WixLanguage="$(BundlerWixLanguage)"
      WixLanguages="$(BundlerWixLanguages)"
      WixLanguageFiles="@(BundlerWixLanguageFile)"
      WixFipsCompliant="$(BundlerWixFipsCompliant)"
      WixStartMenuShortcut="$(BundlerWixStartMenuShortcut)"
      WixDesktopShortcut="$(BundlerWixDesktopShortcut)"
      WixInstallDirectorySelection="$(BundlerWixInstallDirectorySelection)"
      WixBannerFile="$(BundlerWixBannerFile)"
      WixDialogFile="$(BundlerWixDialogFile)"
      WixAddToPath="$(BundlerWixAddToPath)"
      WixUninstallShortcut="$(BundlerWixUninstallShortcut)"
      WixLaunchAfterInstall="$(BundlerWixLaunchAfterInstall)"
      WixExtensionFragmentFiles="@(BundlerWixExtensionFragment)"
      WixExtensionIdPrefix="$(BundlerWixExtensionIdPrefix)"
      WixExtensionComponentRefs="@(BundlerWixExtensionComponentRef)"
      WixExtensionComponentGroupRefs="@(BundlerWixExtensionComponentGroupRef)"
      WixExtensionFeatureRefs="@(BundlerWixExtensionFeatureRef)"
      WixExpertTemplateFile="$(BundlerWixExpertTemplateFile)"
      WixExpertMergeModuleFiles="@(BundlerWixExpertMergeModule)"
      NsisTemplatePath="$(BundlerNsisTemplate)"
      NsisInstallScope="$(BundlerNsisInstallScope)"
      NsisCompression="$(BundlerNsisCompression)"
      NsisInstallerIconFile="$(BundlerNsisInstallerIconFile)"
      NsisUninstallerIconFile="$(BundlerNsisUninstallerIconFile)"
      NsisHeaderFile="$(BundlerNsisHeaderFile)"
      NsisSidebarFile="$(BundlerNsisSidebarFile)"
      NsisUninstallerHeaderFile="$(BundlerNsisUninstallerHeaderFile)"
      NsisInstallerHooksFile="$(BundlerNsisInstallerHooksFile)"
      NsisLanguages="$(BundlerNsisLanguages)"
      NsisDisplayLanguageSelector="$(BundlerNsisDisplayLanguageSelector)"
      NsisAllowDowngrades="$(BundlerNsisAllowDowngrades)"
      NsisShortcutDesktop="$(BundlerNsisShortcutDesktop)"
      NsisShortcutStartMenu="$(BundlerNsisShortcutStartMenu)"
      NsisShortcutArguments="$(BundlerNsisShortcutArguments)"
      NsisShortcutWorkingDirectory="$(BundlerNsisShortcutWorkingDirectory)"
      NsisShortcutIcon="$(BundlerNsisShortcutIcon)"
      NsisShortcutAppUserModelId="$(BundlerNsisShortcutAppUserModelId)"
      NsisShortcutStartMenuFolder="$(BundlerNsisShortcutStartMenuFolder)"
      NsisShortcutLegacyProductNames="$(BundlerNsisShortcutLegacyProductNames)"
      NsisShortcutLegacyMainExecutables="$(BundlerNsisShortcutLegacyMainExecutables)"
      NsisLegacyMsiProductCodes="$(BundlerNsisLegacyMsiProductCodes)"
      NsisLegacyMsiUpgradeCodes="$(BundlerNsisLegacyMsiUpgradeCodes)"
      NsisLegacyMsiAutoDetect="$(BundlerNsisLegacyMsiAutoDetect)"
      WindowsSigningPfxFile="$(BundlerWindowsSigningPfxFile)"
      WindowsSigningPfxPasswordEnvironmentVariable="$(BundlerWindowsSigningPfxPasswordEnvironmentVariable)"
      WindowsSigningCertificateThumbprint="$(BundlerWindowsSigningCertificateThumbprint)"
      WindowsSigningCertificateStoreLocation="$(BundlerWindowsSigningCertificateStoreLocation)"
      WindowsSigningTimestampUrl="$(BundlerWindowsSigningTimestampUrl)"
      WindowsSigningCommand="$(BundlerWindowsSigningCommand)"
      WindowsSigningCommandArguments="@(BundlerWindowsSigningCommandArgument)"
      NsisLanguageFiles="@(BundlerNsisLanguageFile)"
      MacAppPackageName="$(BundlerMacAppPackageName)"
      MacAppDisplayName="$(BundlerMacAppDisplayName)"
      MacAppShortVersion="$(BundlerMacAppShortVersion)"
      MacAppBuildVersion="$(BundlerMacAppBuildVersion)"
      MacAppMinimumSystemVersion="$(BundlerMacAppMinimumSystemVersion)"
      MacAppCategory="$(BundlerMacAppCategory)"
      MacAppIconName="$(BundlerMacAppIconName)"
      MacAppExceptionDomain="$(BundlerMacAppExceptionDomain)"
      MacAppInfoPlistFile="$(BundlerMacAppInfoPlistFile)"
      MacAppInfoPlistXml="$(BundlerMacAppInfoPlistXml)"
      MacAppSignIdentity="$(BundlerMacAppSignIdentity)"
      MacAppTemporaryCertificateFile="$(BundlerMacAppTemporaryCertificateFile)"
      MacAppTemporaryCertificatePassword="$(BundlerMacAppTemporaryCertificatePassword)"
      MacAppHardenedRuntime="$(BundlerMacAppHardenedRuntime)"
      MacAppEntitlementsFile="$(BundlerMacAppEntitlementsFile)"
      MacAppNotarize="$(BundlerMacAppNotarize)"
      MacAppNotaryWait="$(BundlerMacAppNotaryWait)"
      MacAppSkipStapling="$(BundlerMacAppSkipStapling)"
      MacAppNotaryProfile="$(BundlerMacAppNotaryProfile)"
      MacAppAppleId="$(BundlerMacAppAppleId)"
      MacAppApplePassword="$(BundlerMacAppApplePassword)"
      MacAppAppleTeamId="$(BundlerMacAppAppleTeamId)"
      MacAppNotaryApiKeyFile="$(BundlerMacAppNotaryApiKeyFile)"
      MacAppNotaryApiKeyId="$(BundlerMacAppNotaryApiKeyId)"
      MacAppNotaryApiKeyIssuer="$(BundlerMacAppNotaryApiKeyIssuer)"
      MacDmgCompression="$(BundlerMacDmgCompression)"
      MacDmgVolumeName="$(BundlerMacDmgVolumeName)"
      MacDmgLayoutSkip="$(BundlerMacDmgLayoutSkip)"
      MacDmgLayoutWindowX="$(BundlerMacDmgLayoutWindowX)"
      MacDmgLayoutWindowY="$(BundlerMacDmgLayoutWindowY)"
      MacDmgLayoutWindowWidth="$(BundlerMacDmgLayoutWindowWidth)"
      MacDmgLayoutWindowHeight="$(BundlerMacDmgLayoutWindowHeight)"
      MacDmgLayoutAppIconX="$(BundlerMacDmgLayoutAppIconX)"
      MacDmgLayoutAppIconY="$(BundlerMacDmgLayoutAppIconY)"
      MacDmgLayoutApplicationsIconX="$(BundlerMacDmgLayoutApplicationsIconX)"
      MacDmgLayoutApplicationsIconY="$(BundlerMacDmgLayoutApplicationsIconY)"
      MacDmgLayoutIconSize="$(BundlerMacDmgLayoutIconSize)"
      MacDmgBackgroundFile="$(BundlerMacDmgBackgroundFile)"
      MacDmgVolumeIconFile="$(BundlerMacDmgVolumeIconFile)"
      MacDmgSignIdentity="$(BundlerMacDmgSignIdentity)"
      MacDmgTemporaryCertificateFile="$(BundlerMacDmgTemporaryCertificateFile)"
      MacDmgTemporaryCertificatePassword="$(BundlerMacDmgTemporaryCertificatePassword)"
      MacPkgPackageName="$(BundlerMacPkgPackageName)"
      MacPkgVersion="$(BundlerMacPkgVersion)"
      MacPkgInstallRoot="$(BundlerMacPkgInstallRoot)"
      MacPkgFiles="@(BundlerMacPkgFile)"
      MacPkgTitle="$(BundlerMacPkgTitle)"
      MacPkgWelcomeFile="$(BundlerMacPkgWelcomeFile)"
      MacPkgConclusionFile="$(BundlerMacPkgConclusionFile)"
      MacPkgInstallScope="$(BundlerMacPkgInstallScope)"
      MacPkgScriptsDirectory="$(BundlerMacPkgScriptsDirectory)"
      MacPkgSignIdentity="$(BundlerMacPkgSignIdentity)"
      MacPkgTemporaryCertificateFile="$(BundlerMacPkgTemporaryCertificateFile)"
      MacPkgTemporaryCertificatePassword="$(BundlerMacPkgTemporaryCertificatePassword)"
      MacPkgNotarize="$(BundlerMacPkgNotarize)"
      MacPkgNotaryWait="$(BundlerMacPkgNotaryWait)"
      MacPkgSkipStapling="$(BundlerMacPkgSkipStapling)"
      MacPkgNotaryProfile="$(BundlerMacPkgNotaryProfile)"
      MacPkgAppleId="$(BundlerMacPkgAppleId)"
      MacPkgApplePassword="$(BundlerMacPkgApplePassword)"
      MacPkgAppleTeamId="$(BundlerMacPkgAppleTeamId)"
      MacPkgNotaryApiKeyFile="$(BundlerMacPkgNotaryApiKeyFile)"
      MacPkgNotaryApiKeyId="$(BundlerMacPkgNotaryApiKeyId)"
      MacPkgNotaryApiKeyIssuer="$(BundlerMacPkgNotaryApiKeyIssuer)"
      DebPackageName="$(BundlerDebPackageName)"
      DebVersion="$(BundlerDebVersion)"
      DebRelease="$(BundlerDebRelease)"
      DebEpoch="$(BundlerDebEpoch)"
      DebArchitecture="$(BundlerDebArchitecture)"
      DebVendor="$(BundlerDebVendor)"
      DebInstallRoot="$(BundlerDebInstallRoot)"
      DebBinLink="$(BundlerDebBinLink)"
      DebDepends="$(BundlerDebDepends)"
      DebRecommends="$(BundlerDebRecommends)"
      DebProvides="$(BundlerDebProvides)"
      DebConflicts="$(BundlerDebConflicts)"
      DebReplaces="$(BundlerDebReplaces)"
      DebSection="$(BundlerDebSection)"
      DebPriority="$(BundlerDebPriority)"
      DebCategories="$(BundlerDebCategories)"
