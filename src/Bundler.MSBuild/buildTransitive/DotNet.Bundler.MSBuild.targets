      DebSystemdServiceFile="$(BundlerDebSystemdServiceFile)"
      DebConfigLocations="$(BundlerDebConfigLocations)"
      DebFiles="@(BundlerDebFile)"
      RpmPackageName="$(BundlerRpmPackageName)"
