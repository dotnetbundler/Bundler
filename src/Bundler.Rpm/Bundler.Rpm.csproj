<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DotNet.Bundler.Rpm</AssemblyName>
    <RootNamespace>DotNet.Bundler.Rpm</RootNamespace>
    <PackageId>DotNet.Bundler.Rpm</PackageId>
    <Description>Reusable RPM package writer for desktop applications (pure managed, no host tools).</Description>
    <PackageTags>dotnet;bundler;linux;rpm;redhat;fedora;installer;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.Tests" />
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
