<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bundler-updater</AssemblyName>
    <RootNamespace>DotNet.Bundler.Updater.Bootstrap</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>External swap bootstrapper for DotNet.Bundler self-update: wait-exit, backup, atomic swap, restart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.Tests" />
  </ItemGroup>

</Project>
