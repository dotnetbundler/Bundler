<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bundler-updater</AssemblyName>
    <RootNamespace>DotNet.Bundler.Updater.Bootstrap</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);BUNDLER_UPDATER_LINK</DefineConstants>
    <Description>External swap bootstrapper for DotNet.Bundler self-update: wait-exit, backup, atomic swap, restart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.UnitTests" />
    <InternalsVisibleTo Include="Bundler.IntegrationTests" />
    <!-- 普通文件判定件与 argv 拼写件与打包侧/客户端同源链接编译——单源事实，零程序集蔓延。 -->
    <Compile Include="..\Bundler.Core\UnixFileTypes.cs" />
    <Compile Include="..\Bundler.Core\Update\UpdateArgv.cs" />
    <Compile Include="..\Bundler.Core\ToolProcess.cs" />
    <Compile Include="..\Bundler.Core\NativeSpawnUnix.cs" />
  </ItemGroup>

  <!-- musl 静态 -static-pie 件无 .dynsym，裸 DllImport("libc") 运行时不可解析
       （syspkg 冻件腿 rc3 实证）——libc 直绑清单与 Bundler.Updater 包随包
       透传面同源（单一事实在该 props，勿在本文件再抄一份）。 -->
  <Import Project="..\Bundler.Updater\buildTransitive\DotNet.Bundler.Updater.props" />

</Project>
