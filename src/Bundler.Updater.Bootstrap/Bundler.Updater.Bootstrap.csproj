<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bundler-updater</AssemblyName>
    <RootNamespace>DotNet.Bundler.Updater.Bootstrap</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);BUNDLER_UPDATER_LINK</DefineConstants>
    <Description>External swap bootstrapper for DotNet.Bundler self-update: wait-exit, backup, atomic swap, restart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.UnitTests" />
    <InternalsVisibleTo Include="Bundler.IntegrationTests" />
    <!-- 普通文件判定件与 argv 拼写件与打包侧/客户端同源链接编译——单源事实，零程序集蔓延。 -->
    <Compile Include="..\Bundler.Core\UnixFileTypes.cs" />
    <Compile Include="..\Bundler.Core\Update\UpdateArgv.cs" />
    <Compile Include="..\Bundler.Core\ToolProcess.cs" />
    <Compile Include="..\Bundler.Core\NativeSpawnUnix.cs" />
  </ItemGroup>

  <!-- musl 静态 -static-pie 件无 .dynsym，裸 DllImport("libc") 运行时不可解析
       （syspkg 冻件腿 rc3 实证）——NativeSpawnUnix 的 libc 符号在此逐一直绑：
       ILC 把它们发成直接 extern 调用，lld 链接期对 musl 静态库解析，符号缺席
       即链接失败（产线期报错而非运行期崩）。addchdir/addchdir_np 刻意不入清单：
       musl 版本不齐一，留运行时探测缺席走父件锁内 chdir 兜底。 -->
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-musl'))">
    <DirectPInvoke Include="libc!pipe" />
    <DirectPInvoke Include="libc!pipe2" />
    <DirectPInvoke Include="libc!fcntl" />
    <DirectPInvoke Include="libc!close" />
    <DirectPInvoke Include="libc!access" />
    <DirectPInvoke Include="libc!kill" />
    <DirectPInvoke Include="libc!waitpid" />
    <DirectPInvoke Include="libc!chdir" />
    <DirectPInvoke Include="libc!readlink" />
    <DirectPInvoke Include="libc!getcwd" />
    <DirectPInvoke Include="libc!sigemptyset" />
    <DirectPInvoke Include="libc!sigfillset" />
    <DirectPInvoke Include="libc!posix_spawn" />
    <DirectPInvoke Include="libc!posix_spawnattr_init" />
    <DirectPInvoke Include="libc!posix_spawnattr_destroy" />
    <DirectPInvoke Include="libc!posix_spawnattr_setflags" />
    <DirectPInvoke Include="libc!posix_spawnattr_setpgroup" />
    <DirectPInvoke Include="libc!posix_spawnattr_setsigmask" />
    <DirectPInvoke Include="libc!posix_spawnattr_setsigdefault" />
    <DirectPInvoke Include="libc!posix_spawn_file_actions_init" />
    <DirectPInvoke Include="libc!posix_spawn_file_actions_destroy" />
    <DirectPInvoke Include="libc!posix_spawn_file_actions_adddup2" />
    <DirectPInvoke Include="libc!posix_spawn_file_actions_addclose" />
  </ItemGroup>

</Project>
