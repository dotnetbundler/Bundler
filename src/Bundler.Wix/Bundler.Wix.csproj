<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DotNet.Bundler.Wix</AssemblyName>
    <RootNamespace>DotNet.Bundler.Wix</RootNamespace>
    <PackageId>DotNet.Bundler.Wix</PackageId>
    <Description>Reusable WiX 3.14.1 MSI packaging API for Windows desktop applications.</Description>
    <PackageTags>dotnet;bundler;installer;msi;wix;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.Tests" />
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
    <EmbeddedResource Include="..\..\third_party\wix\wix3141-tools.zip"
                      LogicalName="DotNet.Bundler.Wix.Resources.wix3141-tools.zip" />
    <None Include="..\..\third_party\wix\wix3141-source.zip" Pack="true" PackagePath="licenses/wix/" />
    <None Include="..\..\third_party\wix\LICENSE.TXT" Pack="true" PackagePath="licenses/wix/" />
    <None Include="..\..\third_party\wix\msi-wix-provenance.md" Pack="true" PackagePath="licenses/wix/" />
    <None Include="..\..\third_party\wix\SHA256SUMS" Pack="true" PackagePath="licenses/wix/" />
  </ItemGroup>
</Project>
