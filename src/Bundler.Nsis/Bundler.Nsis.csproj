<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DotNet.Bundler.Nsis</AssemblyName>
    <RootNamespace>DotNet.Bundler.Nsis</RootNamespace>
    <PackageId>DotNet.Bundler.Nsis</PackageId>
    <Description>Reusable NSIS packaging API for desktop .NET applications.</Description>
    <PackageTags>dotnet;bundler;installer;nsis;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\third_party\nsis\nsis-toolset-3.12-r1.zip"
                      LogicalName="DotNet.Bundler.Nsis.Resources.nsis-toolset-3.12-r1.zip" />
    <EmbeddedResource Include="templates\installer.nsi"
                      LogicalName="DotNet.Bundler.Nsis.Resources.installer.nsi" />
    <EmbeddedResource Include="templates\languages\*.nsh"
                      LogicalName="DotNet.Bundler.Nsis.Resources.languages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\third_party\nsis\plugins\x86-unicode\DotNetBundlerNsis.dll"
                      LogicalName="DotNet.Bundler.Nsis.Resources.plugins.DotNetBundlerNsis.dll" />
    <None Include="..\..\third_party\nsis\COPYING" Pack="true" PackagePath="licenses/nsis/" />
    <None Include="..\..\third_party\nsis-plugin\LICENSE" Pack="true" PackagePath="licenses/nsis-plugin/" />
  </ItemGroup>
</Project>
