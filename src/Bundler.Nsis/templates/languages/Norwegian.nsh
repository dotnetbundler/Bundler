LangString ShortcutPageTitle ${LANG_NORWEGIAN} "Alternativer for snarveier"
LangString ShortcutPageSubtitle ${LANG_NORWEGIAN} "Velg hvilke snarveier som skal opprettes."
LangString DesktopShortcutLabel ${LANG_NORWEGIAN} "Opprett snarvei på skrivebordet"
LangString StartMenuShortcutLabel ${LANG_NORWEGIAN} "Opprett snarvei på Start-menyen"
LangString NonEmptyDirectoryWarning ${LANG_NORWEGIAN} "Den valgte mappen er ikke tom og gjenkjennes ikke som en eksisterende ${PRODUCT_NAME}-installasjon.$\r$\n$\r$\nFiler med samme navn kan bli overskrevet. Fortsette?"
LangString AppRunningPrompt ${LANG_NORWEGIAN} "${PRODUCT_NAME} kjører og må lukkes før du fortsetter. Lukke nå?"
LangString AppCloseFailed ${LANG_NORWEGIAN} "Kunne ikke lukke ${PRODUCT_NAME}. Lukk programmet manuelt og prøv igjen."
LangString PayloadWriteFailed ${LANG_NORWEGIAN} "Installasjonsfilene kunne ikke oppdateres. Lukk programmer som bruker installasjonsmappen, og prøv igjen. Den forrige installasjonen blir gjenopprettet."
LangString AppDataPageTitle ${LANG_NORWEGIAN} "Programdata"
LangString AppDataPageSubtitle ${LANG_NORWEGIAN} "Velg om programdataene skal fjernes."
LangString DeleteAppDataLabel ${LANG_NORWEGIAN} "Slett programdata (innstillinger, hurtigbuffer og andre lokale data)"
LangString SameVersionDetected ${LANG_NORWEGIAN} "${PRODUCT_NAME} ${PRODUCT_VERSION} er allerede installert.$\r$\n$\r$\nJa: installer på nytt.$\r$\nNei: avinstaller først.$\r$\nAvbryt: behold uendret."
LangString UpgradeDetected ${LANG_NORWEGIAN} "En eldre versjon ($InstalledVersion) er installert.$\r$\n$\r$\nJa: avinstaller før oppgradering (anbefalt).$\r$\nNei: installer over.$\r$\nAvbryt: behold uendret."
LangString DowngradeDetected ${LANG_NORWEGIAN} "En nyere versjon ($InstalledVersion) er installert.$\r$\n$\r$\nJa: avinstaller før nedgradering (anbefalt).$\r$\nNei: installer over.$\r$\nAvbryt: behold uendret."
LangString DowngradeBlocked ${LANG_NORWEGIAN} "En nyere versjon ($InstalledVersion) er allerede installert. Dette installasjonsprogrammet tillater ikke nedgradering."
LangString UnknownVersionDetected ${LANG_NORWEGIAN} "En installasjon med ukjent eller ikke-semantisk versjon ($InstalledVersion) ble funnet.$\r$\n$\r$\nJa: avinstaller først (anbefalt).$\r$\nNei: installer over.$\r$\nAvbryt: behold uendret."
LangString SilentDowngradeBlocked ${LANG_NORWEGIAN} "Automatisk nedgradering er ikke tillatt."
LangString SilentUnknownVersionBlocked ${LANG_NORWEGIAN} "Automatisk installasjon kan ikke erstatte en versjon som ikke kan sammenlignes."
LangString RemovingExistingVersion ${LANG_NORWEGIAN} "Fjerner eksisterende versjon..."
LangString ExistingUninstallFailed ${LANG_NORWEGIAN} "Den eksisterende installasjonen kunne ikke fjernes. Lukk programmet og prøv igjen."
LangString LegacyMsiDetected ${LANG_NORWEGIAN} "En eldre MSI-installasjon ($InstalledVersion) ble funnet. Den må fjernes før denne NSIS-versjonen installeres.$\r$\n$\r$\nFortsette migreringen?"
LangString RemovingLegacyMsiVersion ${LANG_NORWEGIAN} "Fjerner eldre MSI-produkt $LegacyMsiProductCode..."
LangString InvalidRestartMode ${LANG_NORWEGIAN} "/R er bare gyldig sammen med /S, /P eller /UPDATE."
LangString ArgumentsRequireRestart ${LANG_NORWEGIAN} "/ARGS er bare gyldig sammen med /R."
LangString AutomatedNonEmptyDirectoryBlocked ${LANG_NORWEGIAN} "Den automatiske installasjonen avviste en mappe som ikke er tom og ikke tilhører ${PRODUCT_NAME}."
LangString ApplicationLaunchFailed ${LANG_NORWEGIAN} "Installasjonen var vellykket, men ${PRODUCT_NAME} kunne ikke startes."
