LangString StartMenuShortcutLabel ${LANG_VIETNAMESE} "Tạo lối tắt trong menu Bắt đầu"
LangString NonEmptyDirectoryWarning ${LANG_VIETNAMESE} "Thư mục đã chọn không trống và không được nhận dạng là bản cài đặt ${PRODUCT_NAME} hiện có.$\r$\n$\r$\nCác tệp trùng tên có thể bị ghi đè. Tiếp tục?"
LangString AppRunningPrompt ${LANG_VIETNAMESE} "${PRODUCT_NAME} đang chạy và phải được đóng trước khi tiếp tục. Đóng ngay?"
LangString AppCloseFailed ${LANG_VIETNAMESE} "Không thể đóng ${PRODUCT_NAME}. Hãy đóng thủ công rồi thử lại."
LangString PayloadWriteFailed ${LANG_VIETNAMESE} "Không thể cập nhật tệp cài đặt. Hãy đóng các ứng dụng đang dùng thư mục cài đặt rồi thử lại. Bản cài đặt trước sẽ được khôi phục."
LangString AppDataPageTitle ${LANG_VIETNAMESE} "Dữ liệu ứng dụng"
LangString AppDataPageSubtitle ${LANG_VIETNAMESE} "Chọn có xóa dữ liệu ứng dụng hay không."
LangString DeleteAppDataLabel ${LANG_VIETNAMESE} "Xóa dữ liệu ứng dụng (cài đặt, bộ nhớ đệm và dữ liệu cục bộ khác)"
LangString SameVersionDetected ${LANG_VIETNAMESE} "${PRODUCT_NAME} ${PRODUCT_VERSION} đã được cài đặt.$\r$\n$\r$\nCó: cài đặt lại tại chỗ.$\r$\nKhông: gỡ bản hiện có trước.$\r$\nHủy: giữ nguyên."
LangString UpgradeDetected ${LANG_VIETNAMESE} "Đã cài đặt phiên bản cũ hơn ($InstalledVersion).$\r$\n$\r$\nCó: gỡ trước khi nâng cấp (khuyến nghị).$\r$\nKhông: cài đè.$\r$\nHủy: giữ nguyên."
LangString DowngradeDetected ${LANG_VIETNAMESE} "Đã cài đặt phiên bản mới hơn ($InstalledVersion).$\r$\n$\r$\nCó: gỡ trước khi hạ cấp (khuyến nghị).$\r$\nKhông: cài đè.$\r$\nHủy: giữ nguyên."
LangString DowngradeBlocked ${LANG_VIETNAMESE} "Phiên bản mới hơn ($InstalledVersion) đã được cài đặt. Trình cài đặt này không cho phép hạ cấp."
LangString UnknownVersionDetected ${LANG_VIETNAMESE} "Đã tìm thấy bản cài đặt có phiên bản không rõ hoặc không theo ngữ nghĩa ($InstalledVersion).$\r$\n$\r$\nCó: gỡ trước (khuyến nghị).$\r$\nKhông: cài đè.$\r$\nHủy: giữ nguyên."
LangString SilentDowngradeBlocked ${LANG_VIETNAMESE} "Trình cài đặt này không cho phép hạ cấp tự động."
LangString SilentUnknownVersionBlocked ${LANG_VIETNAMESE} "Cài đặt tự động không thể thay thế phiên bản không thể so sánh."
LangString RemovingExistingVersion ${LANG_VIETNAMESE} "Đang xóa phiên bản hiện có..."
LangString ExistingUninstallFailed ${LANG_VIETNAMESE} "Không thể xóa bản cài đặt hiện có. Hãy đóng ứng dụng rồi thử lại."
LangString LegacyMsiDetected ${LANG_VIETNAMESE} "Đã tìm thấy bản cài đặt MSI cũ ($InstalledVersion). Phải xóa trước khi cài phiên bản NSIS này.$\r$\n$\r$\nTiếp tục di chuyển?"
LangString RemovingLegacyMsiVersion ${LANG_VIETNAMESE} "Đang xóa sản phẩm MSI cũ $LegacyMsiProductCode..."
LangString InvalidRestartMode ${LANG_VIETNAMESE} "/R chỉ hợp lệ khi dùng cùng /S, /P hoặc /UPDATE."
LangString ArgumentsRequireRestart ${LANG_VIETNAMESE} "/ARGS chỉ hợp lệ khi dùng cùng /R."
LangString AutomatedNonEmptyDirectoryBlocked ${LANG_VIETNAMESE} "Cài đặt tự động đã từ chối thư mục không trống không thuộc ${PRODUCT_NAME}."
LangString ApplicationLaunchFailed ${LANG_VIETNAMESE} "Cài đặt thành công nhưng không thể khởi động ${PRODUCT_NAME}."
LangString RecoveryManifestMismatch ${LANG_VIETNAMESE} "The interrupted installation was created with a different recovery manifest. Run the original installer with /S /RECOVERONLY and the same /D= directory, then retry."
LangString RecoveryManifestMismatchDetail ${LANG_VIETNAMESE} "The interrupted installation cannot be recovered by this installer because its configuration differs. Run the original installer with /S /RECOVERONLY and the same /D= directory, then retry."
