LangString ShortcutPageTitle ${LANG_SPANISH} "Opciones de accesos directos"
LangString ShortcutPageSubtitle ${LANG_SPANISH} "Elija los accesos directos que desea crear."
LangString DesktopShortcutLabel ${LANG_SPANISH} "Crear acceso directo en el escritorio"
LangString StartMenuShortcutLabel ${LANG_SPANISH} "Crear acceso directo en el menú Inicio"
LangString NonEmptyDirectoryWarning ${LANG_SPANISH} "La carpeta seleccionada no está vacía ni se reconoce como una instalación de ${PRODUCT_NAME}.$\r$\n$\r$\nSe pueden sobrescribir archivos con el mismo nombre. ¿Continuar?"
LangString AppRunningPrompt ${LANG_SPANISH} "${PRODUCT_NAME} está en ejecución y debe cerrarse. ¿Cerrarlo ahora?"
LangString AppCloseFailed ${LANG_SPANISH} "No se pudo cerrar ${PRODUCT_NAME}. Ciérrelo manualmente e inténtelo de nuevo."
LangString PayloadWriteFailed ${LANG_SPANISH} "No se pudieron actualizar los archivos. Cierre las aplicaciones que usen la carpeta de instalación e inténtelo de nuevo. Se restaurará la instalación anterior."
LangString AppDataPageTitle ${LANG_SPANISH} "Datos de la aplicación"
LangString AppDataPageSubtitle ${LANG_SPANISH} "Elija si desea eliminar los datos de la aplicación."
LangString DeleteAppDataLabel ${LANG_SPANISH} "Eliminar datos de la aplicación (configuración, caché y otros datos locales)"
LangString SameVersionDetected ${LANG_SPANISH} "${PRODUCT_NAME} ${PRODUCT_VERSION} ya está instalado.$\r$\n$\r$\nSí: reinstalar.$\r$\nNo: desinstalar primero.$\r$\nCancelar: no realizar cambios."
LangString UpgradeDetected ${LANG_SPANISH} "Hay una versión anterior ($InstalledVersion) instalada.$\r$\n$\r$\nSí: desinstalar antes de actualizar (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString DowngradeDetected ${LANG_SPANISH} "Hay una versión más reciente ($InstalledVersion) instalada.$\r$\n$\r$\nSí: desinstalar antes de volver a una versión anterior (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString DowngradeBlocked ${LANG_SPANISH} "Ya hay una versión más reciente ($InstalledVersion) instalada. Este instalador no permite volver a una versión anterior."
LangString UnknownVersionDetected ${LANG_SPANISH} "Se encontró una instalación con versión desconocida o no semántica ($InstalledVersion).$\r$\n$\r$\nSí: desinstalar primero (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString SilentDowngradeBlocked ${LANG_SPANISH} "Este instalador no permite una reversión automatizada."
LangString SilentUnknownVersionBlocked ${LANG_SPANISH} "La instalación automatizada no puede reemplazar una versión que no se puede comparar."
LangString RemovingExistingVersion ${LANG_SPANISH} "Eliminando la versión existente..."
LangString ExistingUninstallFailed ${LANG_SPANISH} "No se pudo eliminar la instalación existente. Cierre la aplicación e inténtelo de nuevo."
LangString LegacyMsiDetected ${LANG_SPANISH} "Se encontró una instalación MSI anterior ($InstalledVersion). Debe eliminarse antes de instalar esta versión NSIS.$\r$\n$\r$\n¿Continuar con la migración?"
LangString RemovingLegacyMsiVersion ${LANG_SPANISH} "Eliminando el producto MSI anterior $LegacyMsiProductCode..."
LangString InvalidRestartMode ${LANG_SPANISH} "/R solo es válido junto con /S, /P o /UPDATE."
LangString ArgumentsRequireRestart ${LANG_SPANISH} "/ARGS solo es válido junto con /R."
LangString AutomatedNonEmptyDirectoryBlocked ${LANG_SPANISH} "La instalación automatizada rechazó una carpeta no vacía que no pertenece a ${PRODUCT_NAME}."
LangString ApplicationLaunchFailed ${LANG_SPANISH} "La instalación finalizó, pero no se pudo iniciar ${PRODUCT_NAME}."
