LangString ShortcutPageTitle ${LANG_SPANISHINTERNATIONAL} "Opciones de accesos directos"
LangString ShortcutPageSubtitle ${LANG_SPANISHINTERNATIONAL} "Elija los accesos directos que desea crear."
LangString DesktopShortcutLabel ${LANG_SPANISHINTERNATIONAL} "Crear acceso directo en el escritorio"
LangString StartMenuShortcutLabel ${LANG_SPANISHINTERNATIONAL} "Crear acceso directo en el menú Inicio"
LangString NonEmptyDirectoryWarning ${LANG_SPANISHINTERNATIONAL} "La carpeta seleccionada no está vacía ni se reconoce como una instalación de ${PRODUCT_NAME}.$\r$\n$\r$\nSe pueden sobrescribir archivos con el mismo nombre. ¿Continuar?"
LangString AppRunningPrompt ${LANG_SPANISHINTERNATIONAL} "${PRODUCT_NAME} está en ejecución y debe cerrarse. ¿Cerrarlo ahora?"
LangString AppCloseFailed ${LANG_SPANISHINTERNATIONAL} "No se pudo cerrar ${PRODUCT_NAME}. Ciérrelo manualmente e inténtelo de nuevo."
LangString PayloadWriteFailed ${LANG_SPANISHINTERNATIONAL} "No se pudieron actualizar los archivos. Cierre las aplicaciones que usen la carpeta de instalación e inténtelo de nuevo. Se restaurará la instalación anterior."
LangString AppDataPageTitle ${LANG_SPANISHINTERNATIONAL} "Datos de la aplicación"
LangString AppDataPageSubtitle ${LANG_SPANISHINTERNATIONAL} "Elija si desea eliminar los datos de la aplicación."
LangString DeleteAppDataLabel ${LANG_SPANISHINTERNATIONAL} "Eliminar datos de la aplicación (configuración, caché y otros datos locales)"
LangString SameVersionDetected ${LANG_SPANISHINTERNATIONAL} "${PRODUCT_NAME} ${PRODUCT_VERSION} ya está instalado.$\r$\n$\r$\nSí: reinstalar.$\r$\nNo: desinstalar primero.$\r$\nCancelar: no realizar cambios."
LangString UpgradeDetected ${LANG_SPANISHINTERNATIONAL} "Hay una versión anterior ($InstalledVersion) instalada.$\r$\n$\r$\nSí: desinstalar antes de actualizar (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString DowngradeDetected ${LANG_SPANISHINTERNATIONAL} "Hay una versión más reciente ($InstalledVersion) instalada.$\r$\n$\r$\nSí: desinstalar antes de volver a una versión anterior (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString DowngradeBlocked ${LANG_SPANISHINTERNATIONAL} "Ya hay una versión más reciente ($InstalledVersion) instalada. Este instalador no permite volver a una versión anterior."
LangString UnknownVersionDetected ${LANG_SPANISHINTERNATIONAL} "Se encontró una instalación con versión desconocida o no semántica ($InstalledVersion).$\r$\n$\r$\nSí: desinstalar primero (recomendado).$\r$\nNo: instalar encima.$\r$\nCancelar: no realizar cambios."
LangString SilentDowngradeBlocked ${LANG_SPANISHINTERNATIONAL} "Este instalador no permite una reversión automatizada."
LangString SilentUnknownVersionBlocked ${LANG_SPANISHINTERNATIONAL} "La instalación automatizada no puede reemplazar una versión que no se puede comparar."
LangString RemovingExistingVersion ${LANG_SPANISHINTERNATIONAL} "Eliminando la versión existente..."
LangString ExistingUninstallFailed ${LANG_SPANISHINTERNATIONAL} "No se pudo eliminar la instalación existente. Cierre la aplicación e inténtelo de nuevo."
LangString LegacyMsiDetected ${LANG_SPANISHINTERNATIONAL} "Se encontró una instalación MSI anterior ($InstalledVersion). Debe eliminarse antes de instalar esta versión NSIS.$\r$\n$\r$\n¿Continuar con la migración?"
LangString RemovingLegacyMsiVersion ${LANG_SPANISHINTERNATIONAL} "Eliminando el producto MSI anterior $LegacyMsiProductCode..."
LangString InvalidRestartMode ${LANG_SPANISHINTERNATIONAL} "/R solo es válido junto con /S, /P o /UPDATE."
LangString ArgumentsRequireRestart ${LANG_SPANISHINTERNATIONAL} "/ARGS solo es válido junto con /R."
LangString AutomatedNonEmptyDirectoryBlocked ${LANG_SPANISHINTERNATIONAL} "La instalación automatizada rechazó una carpeta no vacía que no pertenece a ${PRODUCT_NAME}."
LangString ApplicationLaunchFailed ${LANG_SPANISHINTERNATIONAL} "La instalación finalizó, pero no se pudo iniciar ${PRODUCT_NAME}."
LangString RecoveryManifestMismatch ${LANG_SPANISHINTERNATIONAL} "The interrupted installation was created with a different recovery manifest. Run the original installer with /S /RECOVERONLY and the same /D= directory, then retry."
LangString RecoveryManifestMismatchDetail ${LANG_SPANISHINTERNATIONAL} "The interrupted installation cannot be recovered by this installer because its configuration differs. Run the original installer with /S /RECOVERONLY and the same /D= directory, then retry."
