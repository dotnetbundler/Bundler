<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bundler</AssemblyName>
    <RootNamespace>DotNet.Bundler.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bundler</ToolCommandName>
    <PackageId>DotNet.Bundler.Cli</PackageId>
    <Version>$(BundlerPackageVersion)</Version>
    <Authors>Bundler contributors</Authors>
    <Description>Command-line interface for DotNet.Bundler — validate, plan and bundle desktop application publish directories into native installers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Native AOT binary alongside the dotnet tool package: `dotnet publish -r <rid>` -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StackSizeSupport>false</StackSizeSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bundler.Core\Bundler.Core.csproj" />
    <ProjectReference Include="..\Bundler.Nsis\Bundler.Nsis.csproj" />
    <ProjectReference Include="..\Bundler.Wix\Bundler.Wix.csproj" />
    <ProjectReference Include="..\Bundler.MacApp\Bundler.MacApp.csproj" />
    <ProjectReference Include="..\Bundler.MacDmg\Bundler.MacDmg.csproj" />
    <ProjectReference Include="..\Bundler.MacPkg\Bundler.MacPkg.csproj" />
    <ProjectReference Include="..\Bundler.Deb\Bundler.Deb.csproj" />
    <ProjectReference Include="..\Bundler.Rpm\Bundler.Rpm.csproj" />
    <ProjectReference Include="..\Bundler.AppImage\Bundler.AppImage.csproj" />
    <ProjectReference Include="..\Bundler.Archive\Bundler.Archive.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bundler.Tests" />
  </ItemGroup>
</Project>
