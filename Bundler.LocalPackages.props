<Project>
  <PropertyGroup>
    <!-- 版本只在根 Directory.Build.props 定义；隔离 fixture 由脚本传入版本。 -->
    <!-- 公开示例使用仓库本地源；隔离 fixture 由脚本显式传入包源。 -->
    <BundlerPackageSource Condition="'$(BundlerPackageSource)' == '' and '$(BundlerUseRepositoryPackageSource)' == 'true'">$(MSBuildThisFileDirectory)artifacts\packages</BundlerPackageSource>
    <!-- fixture/示例只引用本地打出的 Bundler 包，源必须保持纯本地：
         Assert-LocalBundlerRestore 会拒绝还原配置里出现任何网络源。 -->
    <RestoreSources Condition="'$(BundlerPackageSource)' != ''">$(BundlerPackageSource)</RestoreSources>
  </PropertyGroup>
</Project>
