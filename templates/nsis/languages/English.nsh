LangString ShortcutPageTitle ${LANG_ENGLISH} "Shortcut options"
LangString ShortcutPageSubtitle ${LANG_ENGLISH} "Choose which shortcuts to create."
LangString DesktopShortcutLabel ${LANG_ENGLISH} "Create a desktop shortcut"
LangString StartMenuShortcutLabel ${LANG_ENGLISH} "Create a Start Menu shortcut"
LangString NonEmptyDirectoryWarning ${LANG_ENGLISH} "The selected folder is not empty and is not recognized as an existing ${PRODUCT_NAME} installation.$\r$\n$\r$\nFiles with the same names may be overwritten. Continue?"
LangString AppRunningPrompt ${LANG_ENGLISH} "${PRODUCT_NAME} is running. It must be closed before continuing. Close it now?"
LangString AppCloseFailed ${LANG_ENGLISH} "Could not close ${PRODUCT_NAME}. Close it manually and try again."
LangString AppDataPageTitle ${LANG_ENGLISH} "Application data"
LangString AppDataPageSubtitle ${LANG_ENGLISH} "Choose whether to remove your application data."
LangString DeleteAppDataLabel ${LANG_ENGLISH} "Delete application data (settings, cache, and other local data)"
LangString SameVersionDetected ${LANG_ENGLISH} "${PRODUCT_NAME} ${PRODUCT_VERSION} is already installed.$\r$\n$\r$\nYes: reinstall in place.$\r$\nNo: uninstall the existing copy first.$\r$\nCancel: leave the existing installation unchanged."
LangString UpgradeDetected ${LANG_ENGLISH} "An older version ($InstalledVersion) is installed.$\r$\n$\r$\nYes: uninstall it before upgrading (recommended).$\r$\nNo: install over it.$\r$\nCancel: leave it unchanged."
LangString DowngradeDetected ${LANG_ENGLISH} "A newer version ($InstalledVersion) is installed.$\r$\n$\r$\nYes: uninstall it before downgrading (recommended).$\r$\nNo: install over it.$\r$\nCancel: leave it unchanged."
LangString DowngradeBlocked ${LANG_ENGLISH} "A newer version ($InstalledVersion) is already installed. This installer does not allow downgrades."
LangString UnknownVersionDetected ${LANG_ENGLISH} "An installation with an unknown or non-semantic version ($InstalledVersion) was found.$\r$\n$\r$\nYes: uninstall it first (recommended).$\r$\nNo: install over it.$\r$\nCancel: leave it unchanged."
LangString SilentDowngradeBlocked ${LANG_ENGLISH} "A silent downgrade is not allowed by this installer."
LangString SilentUnknownVersionBlocked ${LANG_ENGLISH} "A silent install cannot replace an installation whose version cannot be compared."
LangString RemovingExistingVersion ${LANG_ENGLISH} "Removing the existing version..."
LangString ExistingUninstallFailed ${LANG_ENGLISH} "The existing installation could not be removed. Close the application and try again."
LangString LegacyMsiDetected ${LANG_ENGLISH} "A legacy MSI installation ($InstalledVersion) was found. It must be removed before installing this NSIS version.$\r$\n$\r$\nContinue with migration?"
LangString RemovingLegacyMsiVersion ${LANG_ENGLISH} "Removing legacy MSI product $LegacyMsiProductCode..."
