<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HelloMacApp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- png=PNG 合成 icns；car=采用预编译 Assets.car（Assets/hello.car）；icon=HelloMacAppIconSource 指向 Icon Composer .icon 目录，经 actool 编译 -->
    <HelloMacAppIconMode Condition="'$(HelloMacAppIconMode)' == ''">png</HelloMacAppIconMode>
    <HelloMacAppIconSource Condition="'$(HelloMacAppIconSource)' == ''"></HelloMacAppIconSource>
    <!-- file=extra.plist 文件合并；xml=BundlerMacAppInfoPlistXml 内联合并 -->
    <HelloMacAppInfoPlistMode Condition="'$(HelloMacAppInfoPlistMode)' == ''">file</HelloMacAppInfoPlistMode>
    <HelloMacAppSignIdentity Condition="'$(HelloMacAppSignIdentity)' == ''"></HelloMacAppSignIdentity>
    <HelloMacAppSigningCertificatePath Condition="'$(HelloMacAppSigningCertificatePath)' == ''"></HelloMacAppSigningCertificatePath>
    <HelloMacAppSigningCertificatePassword Condition="'$(HelloMacAppSigningCertificatePassword)' == ''"></HelloMacAppSigningCertificatePassword>
    <HelloMacAppHardenedRuntime Condition="'$(HelloMacAppHardenedRuntime)' == ''">true</HelloMacAppHardenedRuntime>
    <HelloMacAppEntitlementsFile Condition="'$(HelloMacAppEntitlementsFile)' == ''">$(MSBuildThisFileDirectory)Assets\entitlements.plist</HelloMacAppEntitlementsFile>
    <HelloMacAppNotarize Condition="'$(HelloMacAppNotarize)' == ''">false</HelloMacAppNotarize>
    <HelloMacAppNotaryWait Condition="'$(HelloMacAppNotaryWait)' == ''"></HelloMacAppNotaryWait>
    <HelloMacAppSkipStapling Condition="'$(HelloMacAppSkipStapling)' == ''"></HelloMacAppSkipStapling>
    <HelloMacAppNotaryProfile Condition="'$(HelloMacAppNotaryProfile)' == ''"></HelloMacAppNotaryProfile>
    <HelloMacAppAppleId Condition="'$(HelloMacAppAppleId)' == ''"></HelloMacAppAppleId>
    <HelloMacAppApplePassword Condition="'$(HelloMacAppApplePassword)' == ''"></HelloMacAppApplePassword>
    <HelloMacAppAppleTeamId Condition="'$(HelloMacAppAppleTeamId)' == ''"></HelloMacAppAppleTeamId>
    <HelloMacAppNotaryApiKeyPath Condition="'$(HelloMacAppNotaryApiKeyPath)' == ''"></HelloMacAppNotaryApiKeyPath>
    <HelloMacAppNotaryApiKeyId Condition="'$(HelloMacAppNotaryApiKeyId)' == ''"></HelloMacAppNotaryApiKeyId>
    <HelloMacAppNotaryApiIssuer Condition="'$(HelloMacAppNotaryApiIssuer)' == ''"></HelloMacAppNotaryApiIssuer>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>app</BundlerFormats>
    <BundlerIdentifier>com.example.hellomacapp</BundlerIdentifier>
    <BundlerProductName>Hello Mac App</BundlerProductName>
    <BundlerPublisher>Bundler Contributors</BundlerPublisher>
    <BundlerDescription>演示 DotNet.Bundler 当前支持的 macOS .app 功能。</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler</BundlerHomepage>
    <BundlerCopyright>Copyright © DotNet.Bundler contributors</BundlerCopyright>
    <BundlerMacAppDisplayName>Hello Mac App</BundlerMacAppDisplayName>
    <BundlerMacAppBuildVersion>1</BundlerMacAppBuildVersion>
    <BundlerMacAppShortVersion>1.0</BundlerMacAppShortVersion>
    <BundlerMacAppMinimumSystemVersion>12.0</BundlerMacAppMinimumSystemVersion>
    <BundlerMacAppCategory>public.app-category.developer-tools</BundlerMacAppCategory>
    <BundlerMacAppExceptionDomain>hello.example.local</BundlerMacAppExceptionDomain>
    <BundlerMacAppIconName Condition="'$(HelloMacAppIconMode)' == 'car'">AppIcon</BundlerMacAppIconName>
    <BundlerMacAppIconName Condition="'$(HelloMacAppIconMode)' != 'car'">HelloMacAppIcon</BundlerMacAppIconName>
    <BundlerMacAppInfoPlistFile Condition="'$(HelloMacAppInfoPlistMode)' == 'file'">$(MSBuildThisFileDirectory)extra.plist</BundlerMacAppInfoPlistFile>
    <BundlerMacAppInfoPlistXml Condition="'$(HelloMacAppInfoPlistMode)' == 'xml'">&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;&lt;plist version=&quot;1.0&quot;&gt;&lt;dict&gt;&lt;key&gt;NSSupportsSuddenTermination&lt;/key&gt;&lt;true/&gt;&lt;key&gt;HelloMacCustomKey&lt;/key&gt;&lt;string&gt;hello&lt;/string&gt;&lt;/dict&gt;&lt;/plist&gt;</BundlerMacAppInfoPlistXml>
    <BundlerMacAppSignIdentity Condition="'$(HelloMacAppSignIdentity)' != ''">$(HelloMacAppSignIdentity)</BundlerMacAppSignIdentity>
    <BundlerMacAppSigningCertificatePath Condition="'$(HelloMacAppSigningCertificatePath)' != ''">$(HelloMacAppSigningCertificatePath)</BundlerMacAppSigningCertificatePath>
    <BundlerMacAppSigningCertificatePassword Condition="'$(HelloMacAppSigningCertificatePassword)' != ''">$(HelloMacAppSigningCertificatePassword)</BundlerMacAppSigningCertificatePassword>
    <BundlerMacAppHardenedRuntime Condition="'$(HelloMacAppSignIdentity)' != ''">$(HelloMacAppHardenedRuntime)</BundlerMacAppHardenedRuntime>
    <BundlerMacAppEntitlementsFile Condition="'$(HelloMacAppSignIdentity)' != ''">$(HelloMacAppEntitlementsFile)</BundlerMacAppEntitlementsFile>
    <BundlerMacAppNotarize>$(HelloMacAppNotarize)</BundlerMacAppNotarize>
    <BundlerMacAppNotaryWait Condition="'$(HelloMacAppNotaryWait)' != ''">$(HelloMacAppNotaryWait)</BundlerMacAppNotaryWait>
    <BundlerMacAppSkipStapling Condition="'$(HelloMacAppSkipStapling)' != ''">$(HelloMacAppSkipStapling)</BundlerMacAppSkipStapling>
    <BundlerMacAppNotaryProfile Condition="'$(HelloMacAppNotaryProfile)' != ''">$(HelloMacAppNotaryProfile)</BundlerMacAppNotaryProfile>
    <BundlerMacAppAppleId Condition="'$(HelloMacAppAppleId)' != ''">$(HelloMacAppAppleId)</BundlerMacAppAppleId>
    <BundlerMacAppApplePassword Condition="'$(HelloMacAppApplePassword)' != ''">$(HelloMacAppApplePassword)</BundlerMacAppApplePassword>
    <BundlerMacAppAppleTeamId Condition="'$(HelloMacAppAppleTeamId)' != ''">$(HelloMacAppAppleTeamId)</BundlerMacAppAppleTeamId>
    <BundlerMacAppNotaryApiKeyPath Condition="'$(HelloMacAppNotaryApiKeyPath)' != ''">$(HelloMacAppNotaryApiKeyPath)</BundlerMacAppNotaryApiKeyPath>
    <BundlerMacAppNotaryApiKeyId Condition="'$(HelloMacAppNotaryApiKeyId)' != ''">$(HelloMacAppNotaryApiKeyId)</BundlerMacAppNotaryApiKeyId>
    <BundlerMacAppNotaryApiIssuer Condition="'$(HelloMacAppNotaryApiIssuer)' != ''">$(HelloMacAppNotaryApiIssuer)</BundlerMacAppNotaryApiIssuer>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.ProjectReference.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <BundlerIcon Include="Assets/icon-256.png" Condition="'$(HelloMacAppIconMode)' == 'png'" />
    <BundlerIcon Include="Assets/icon-512.png" Condition="'$(HelloMacAppIconMode)' == 'png'" />
    <BundlerIcon Include="Assets/hello.car" Condition="'$(HelloMacAppIconMode)' == 'car'" />
    <BundlerIcon Include="$(HelloMacAppIconSource)" Condition="'$(HelloMacAppIconMode)' == 'icon' and '$(HelloMacAppIconSource)' != ''" />
    <BundlerResource Include="Assets/demo-resource.txt" TargetPath="docs/readme.txt" />
    <BundlerMacFramework Include="Assets/libhello.dylib" />
    <BundlerFileAssociation Include="hellomac" Name="Hello Mac Document" Description="HelloMacApp 演示文档" MimeType="application/x-hellomac" />
    <BundlerUrlProtocol Include="hellomac" Name="Hello Mac Link" />
    <BundlerMacDocumentType Include="hellomac" Role="Editor" Rank="Owner" ExportedTypeIdentifier="com.example.hellomacapp.hellomac" ExportedTypeConformsTo="public.data" />
    <BundlerMacUrlType Include="hellomac" Role="Viewer" />
    <BundlerMacContent Include="Assets/shared-note.txt" TargetPath="SharedSupport/shared-note.txt" />
  </ItemGroup>
</Project>
