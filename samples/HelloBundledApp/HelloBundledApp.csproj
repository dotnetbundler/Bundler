<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RestoreSources>$(MSBuildThisFileDirectory)..\..\artifacts\packages</RestoreSources>
    <HelloBundledAppInstallMode Condition="'$(HelloBundledAppInstallMode)' == ''">currentUser</HelloBundledAppInstallMode>
    <HelloBundledAppAllowDowngrades Condition="'$(HelloBundledAppAllowDowngrades)' == ''">false</HelloBundledAppAllowDowngrades>
    <HelloBundledAppLegacyMsiProductCodes Condition="'$(HelloBundledAppLegacyMsiProductCodes)' == ''"></HelloBundledAppLegacyMsiProductCodes>
    <HelloBundledAppLegacyMsiUpgradeCodes Condition="'$(HelloBundledAppLegacyMsiUpgradeCodes)' == ''"></HelloBundledAppLegacyMsiUpgradeCodes>
    <HelloBundledAppSigningPfxFile Condition="'$(HelloBundledAppSigningPfxFile)' == ''"></HelloBundledAppSigningPfxFile>
    <HelloBundledAppSigningPfxPasswordEnvironmentVariable Condition="'$(HelloBundledAppSigningPfxPasswordEnvironmentVariable)' == ''"></HelloBundledAppSigningPfxPasswordEnvironmentVariable>
    <HelloBundledAppSigningCertificateThumbprint Condition="'$(HelloBundledAppSigningCertificateThumbprint)' == ''"></HelloBundledAppSigningCertificateThumbprint>
    <HelloBundledAppSigningTimestampUrl Condition="'$(HelloBundledAppSigningTimestampUrl)' == ''"></HelloBundledAppSigningTimestampUrl>
    <HelloBundledAppSigningCommand Condition="'$(HelloBundledAppSigningCommand)' == ''"></HelloBundledAppSigningCommand>
    <HelloBundledAppSigningCommandArguments Condition="'$(HelloBundledAppSigningCommandArguments)' == ''"></HelloBundledAppSigningCommandArguments>
    <_HelloBundledAppToolsetArchive>$(MSBuildThisFileDirectory)..\..\third_party\nsis\nsis-toolset-3.12-r1.zip</_HelloBundledAppToolsetArchive>
    <_HelloBundledAppArtworkDirectory>$(BaseIntermediateOutputPath)sample-nsis-artwork\</_HelloBundledAppArtworkDirectory>
    <_HelloBundledAppArtworkRoot>$(_HelloBundledAppArtworkDirectory)common\Contrib\Graphics</_HelloBundledAppArtworkRoot>
    <_HelloBundledAppArtworkMarker>$(_HelloBundledAppArtworkDirectory).complete</_HelloBundledAppArtworkMarker>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>nsis</BundlerFormats>
    <BundlerIdentifier>com.example.hellobundledapp</BundlerIdentifier>
    <BundlerProductName>Hello Bundled App</BundlerProductName>
    <BundlerPublisher>Bundler Contributors</BundlerPublisher>
    <BundlerDescription>演示 DotNet.Bundler 当前支持的 Windows NSIS 功能。</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler</BundlerHomepage>
    <BundlerCopyright>Copyright © DotNet.Bundler contributors</BundlerCopyright>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets\license.txt</BundlerLicenseFile>
    <BundlerNsisInstallMode>$(HelloBundledAppInstallMode)</BundlerNsisInstallMode>
    <BundlerNsisCompression>zlib</BundlerNsisCompression>
    <BundlerNsisLanguages>English;SimpChinese;Japanese</BundlerNsisLanguages>
    <BundlerNsisDisplayLanguageSelector>true</BundlerNsisDisplayLanguageSelector>
    <BundlerNsisInstallerIcon>$(_HelloBundledAppArtworkRoot)\Icons\modern-install-colorful.ico</BundlerNsisInstallerIcon>
    <BundlerNsisUninstallerIcon>$(_HelloBundledAppArtworkRoot)\Icons\modern-uninstall-colorful.ico</BundlerNsisUninstallerIcon>
    <BundlerNsisHeaderImage>$(_HelloBundledAppArtworkRoot)\Header\nsis3-grey.bmp</BundlerNsisHeaderImage>
    <BundlerNsisUninstallerHeaderImage>$(_HelloBundledAppArtworkRoot)\Header\orange-uninstall.bmp</BundlerNsisUninstallerHeaderImage>
    <BundlerNsisSidebarImage>$(_HelloBundledAppArtworkRoot)\Wizard\nsis3-grey.bmp</BundlerNsisSidebarImage>
    <BundlerNsisInstallerHooks>$(MSBuildThisFileDirectory)Assets\installer-hooks.nsh</BundlerNsisInstallerHooks>
    <BundlerNsisAllowDowngrades>$(HelloBundledAppAllowDowngrades)</BundlerNsisAllowDowngrades>
    <BundlerNsisShortcutDesktop>true</BundlerNsisShortcutDesktop>
    <BundlerNsisShortcutStartMenu>true</BundlerNsisShortcutStartMenu>
    <BundlerNsisShortcutArguments>--from-shortcut &quot;你好 world&quot;</BundlerNsisShortcutArguments>
    <BundlerNsisShortcutWorkingDirectory>演示资源</BundlerNsisShortcutWorkingDirectory>
    <BundlerNsisShortcutIcon>HelloBundledApp.exe</BundlerNsisShortcutIcon>
    <BundlerNsisShortcutAppUserModelId>com.example.hellobundledapp.desktop</BundlerNsisShortcutAppUserModelId>
    <BundlerNsisShortcutStartMenuFolder>Bundler Examples</BundlerNsisShortcutStartMenuFolder>
    <BundlerNsisShortcutLegacyProductNames>Hello Bundled App Preview</BundlerNsisShortcutLegacyProductNames>
    <BundlerNsisShortcutLegacyMainExecutables>HelloBundledApp.Preview.exe</BundlerNsisShortcutLegacyMainExecutables>
    <BundlerNsisLegacyMsiProductCodes>$(HelloBundledAppLegacyMsiProductCodes)</BundlerNsisLegacyMsiProductCodes>
    <BundlerNsisLegacyMsiUpgradeCodes>$(HelloBundledAppLegacyMsiUpgradeCodes)</BundlerNsisLegacyMsiUpgradeCodes>
    <BundlerWindowsSigningPfxFile>$(HelloBundledAppSigningPfxFile)</BundlerWindowsSigningPfxFile>
    <BundlerWindowsSigningPfxPasswordEnvironmentVariable>$(HelloBundledAppSigningPfxPasswordEnvironmentVariable)</BundlerWindowsSigningPfxPasswordEnvironmentVariable>
    <BundlerWindowsSigningCertificateThumbprint>$(HelloBundledAppSigningCertificateThumbprint)</BundlerWindowsSigningCertificateThumbprint>
    <BundlerWindowsSigningTimestampUrl>$(HelloBundledAppSigningTimestampUrl)</BundlerWindowsSigningTimestampUrl>
    <BundlerWindowsSigningCommand>$(HelloBundledAppSigningCommand)</BundlerWindowsSigningCommand>
    <Version>1.0.0</Version>
    <ApplicationIcon>$(_HelloBundledAppArtworkRoot)\Icons\modern-install-colorful.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="0.1.0-alpha.34" PrivateAssets="all" />
    <BundlerIcon Include="$(_HelloBundledAppArtworkRoot)\Icons\modern-install-colorful.ico" />
    <BundlerResource Include="Assets\demo-resource.txt" TargetPath="演示资源\说明.txt" />
    <BundlerResource Include="Assets\demo.hello" TargetPath="demo.hello" />
    <BundlerResource Include="Assets\运行深链接.cmd" TargetPath="运行深链接.cmd" />
    <BundlerFileAssociation Include="hello"
                            Name="Hello Bundled App 文档"
                            Description="Hello Bundled App 演示文档"
                            MimeType="application/x-hello-bundled-app" />
    <BundlerUrlProtocol Include="hello-bundled" Name="Hello Bundled App 深链接" />
    <BundlerNsisLanguageFile Include="Assets\SimpChinese.nsh" Language="SimpChinese" />
    <BundlerWindowsSigningCommandArgument Include="$(HelloBundledAppSigningCommandArguments)"
                                         Condition="'$(HelloBundledAppSigningCommandArguments)' != ''" />
  </ItemGroup>

  <Target Name="PrepareHelloBundledAppArtwork"
          BeforeTargets="CoreCompile;BundleDesktopApplication"
          Inputs="$(_HelloBundledAppToolsetArchive)"
          Outputs="$(_HelloBundledAppArtworkMarker)">
    <Unzip SourceFiles="$(_HelloBundledAppToolsetArchive)"
           DestinationFolder="$(_HelloBundledAppArtworkDirectory)"
           SkipUnchangedFiles="true" />
    <Touch Files="$(_HelloBundledAppArtworkMarker)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_HelloBundledAppArtworkDirectory)**\*" />
      <FileWrites Include="$(_HelloBundledAppArtworkMarker)" />
    </ItemGroup>
  </Target>

  <!-- 只清理这个示例从固定工具集生成的图片目录。 -->
  <Target Name="CleanHelloBundledAppArtwork" AfterTargets="Clean">
    <RemoveDir Directories="$(_HelloBundledAppArtworkDirectory)" />
  </Target>
</Project>
