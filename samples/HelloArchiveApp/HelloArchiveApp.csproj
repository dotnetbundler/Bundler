<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>HelloArchiveApp</AssemblyName>
    <Version>1.2.3</Version>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>zip;targz</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.helloarchiveapp</BundlerIdentifier>
    <BundlerProductName>Hello Archive App</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler</BundlerPublisher>
    <BundlerDescription>Sample .zip/.tar.gz bundle produced by DotNet.Bundler</BundlerDescription>
    <BundlerArchivePackageName>hello-archive-app</BundlerArchivePackageName>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.ProjectReference.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <BundlerArchiveFile Include="assets/readme.txt" Destination="docs/readme.txt" />
  </ItemGroup>
</Project>
