<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloMacPkg：DotNet.Bundler macOS .pkg 全功能演示示例。
    组件包旋钮（identifier/version/install-location/任意载荷）都可用下方条件属性演示；
    .app 自身的完整旋钮请参考 samples/HelloMacApp（pkg 打包会先生成同样的 .app 中间产物）。
    变体命令见 mac-pkg-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <AssemblyName>HelloMacPkg</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <!-- pkg 请求会让规划器自动先产出 .app 中间产物，再打 .pkg。 -->
    <BundlerFormats>pkg</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.hellomacpkg</BundlerIdentifier>
    <BundlerProductName>Hello Mac PKG</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler macOS .pkg demonstration sample.</BundlerDescription>
    <BundlerCopyright>Copyright DotNet.Bundler Samples</BundlerCopyright>

    <!-- .pkg 公开旋钮：identifier（默认=BundlerIdentifier）、version（默认=Version）、
         install-location（默认 /Applications）、BundlerPkgPayload 任意载荷项。 -->
    <BundlerMacPkgIdentifier Condition="'$(HelloMacPkgIdentifier)' != ''">$(HelloMacPkgIdentifier)</BundlerMacPkgIdentifier>
    <BundlerMacPkgVersion Condition="'$(HelloMacPkgVersion)' != ''">$(HelloMacPkgVersion)</BundlerMacPkgVersion>
    <BundlerMacPkgInstallLocation Condition="'$(HelloMacPkgInstallLocation)' != ''">$(HelloMacPkgInstallLocation)</BundlerMacPkgInstallLocation>

    <!-- 分发包旋钮（任一配置即将产物升级为 productbuild 分发包）：
         title（默认=产品名）、welcome/conclusion 富文本页、许可页复用 BundlerLicenseFile、
         安装域名 System（默认，需管理员）/CurrentUserHome（免提权装到 ~/）。 -->
    <BundlerMacPkgTitle Condition="'$(HelloMacPkgTitle)' != ''">$(HelloMacPkgTitle)</BundlerMacPkgTitle>
    <BundlerMacPkgWelcomeFile Condition="'$(HelloMacPkgWelcome)' == 'true'">Assets/welcome.txt</BundlerMacPkgWelcomeFile>
    <BundlerMacPkgConclusionFile Condition="'$(HelloMacPkgConclusion)' == 'true'">Assets/conclusion.rtf</BundlerMacPkgConclusionFile>
    <BundlerLicenseFile Condition="'$(HelloMacPkgLicense)' == 'true'">Assets/license.txt</BundlerLicenseFile>
    <BundlerMacPkgDomain Condition="'$(HelloMacPkgDomain)' != ''">$(HelloMacPkgDomain)</BundlerMacPkgDomain>

    <!-- 签名/公证/脚本旋钮（MAC-PKG-3）：.pkg 只有真实 Developer ID Installer 签名，无 ad-hoc；
         Notarize 走 notarytool+stapler（凭证取显式属性或 APPLE_* 环境变量）；
         ScriptsDirectory 是专家旋钮：目录原样交给 pkgbuild 的 scripts 旗标，脚本以安装器权限运行。 -->
    <BundlerMacPkgScriptsDirectory Condition="'$(HelloMacPkgScripts)' == 'true'">Scripts</BundlerMacPkgScriptsDirectory>
    <BundlerMacPkgSignIdentity Condition="'$(HelloMacPkgSignIdentity)' != ''">$(HelloMacPkgSignIdentity)</BundlerMacPkgSignIdentity>
    <BundlerMacPkgSignCertificatePath Condition="'$(HelloMacPkgSignCertificatePath)' != ''">$(HelloMacPkgSignCertificatePath)</BundlerMacPkgSignCertificatePath>
    <BundlerMacPkgSignCertificatePassword Condition="'$(HelloMacPkgSignCertificatePassword)' != ''">$(HelloMacPkgSignCertificatePassword)</BundlerMacPkgSignCertificatePassword>
    <BundlerMacPkgNotarize Condition="'$(HelloMacPkgNotarize)' == 'true'">true</BundlerMacPkgNotarize>
    <BundlerMacPkgNotaryWait Condition="'$(HelloMacPkgNotaryWait)' != ''">$(HelloMacPkgNotaryWait)</BundlerMacPkgNotaryWait>
    <BundlerMacPkgSkipStapling Condition="'$(HelloMacPkgSkipStapling)' == 'true'">true</BundlerMacPkgSkipStapling>
    <BundlerMacPkgNotaryProfile Condition="'$(HelloMacPkgNotaryProfile)' != ''">$(HelloMacPkgNotaryProfile)</BundlerMacPkgNotaryProfile>
    <BundlerMacPkgAppleId Condition="'$(HelloMacPkgAppleId)' != ''">$(HelloMacPkgAppleId)</BundlerMacPkgAppleId>
    <BundlerMacPkgApplePassword Condition="'$(HelloMacPkgApplePassword)' != ''">$(HelloMacPkgApplePassword)</BundlerMacPkgApplePassword>
    <BundlerMacPkgAppleTeamId Condition="'$(HelloMacPkgAppleTeamId)' != ''">$(HelloMacPkgAppleTeamId)</BundlerMacPkgAppleTeamId>
    <BundlerMacPkgNotaryApiKeyPath Condition="'$(HelloMacPkgNotaryApiKeyPath)' != ''">$(HelloMacPkgNotaryApiKeyPath)</BundlerMacPkgNotaryApiKeyPath>
    <BundlerMacPkgNotaryApiKeyId Condition="'$(HelloMacPkgNotaryApiKeyId)' != ''">$(HelloMacPkgNotaryApiKeyId)</BundlerMacPkgNotaryApiKeyId>
    <BundlerMacPkgNotaryApiIssuer Condition="'$(HelloMacPkgNotaryApiIssuer)' != ''">$(HelloMacPkgNotaryApiIssuer)</BundlerMacPkgNotaryApiIssuer>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.ProjectReference.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <!-- 任意文件树载荷演示：该文件随 .app 一起进入 payload，落到 install-location 下的 support/ 目录。 -->
    <BundlerPkgPayload Include="Assets/readme.txt" Destination="support/readme.txt" />
  </ItemGroup>
</Project>
