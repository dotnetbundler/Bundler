<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloMacPkg：DotNet.Bundler macOS .pkg 全功能演示示例。
    组件包旋钮（identifier/version/install-location/任意载荷）都可用下方条件属性演示；
    .app 自身的完整旋钮请参考 samples/HelloMacApp（pkg 打包会先生成同样的 .app 中间产物）。
    变体命令见 mac-pkg-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <AssemblyName>HelloMacPkg</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <!-- pkg 请求会让规划器自动先产出 .app 中间产物，再打 .pkg。 -->
    <BundlerFormats>pkg</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.hellomacpkg</BundlerIdentifier>
    <BundlerProductName>Hello Mac PKG</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler macOS .pkg demonstration sample.</BundlerDescription>
    <BundlerCopyright>Copyright DotNet.Bundler Samples</BundlerCopyright>

    <!-- .pkg 公开旋钮：identifier（默认=BundlerIdentifier）、version（默认=Version）、
         install-location（默认 /Applications）、BundlerPkgPayload 任意载荷项。 -->
    <BundlerMacPkgIdentifier Condition="'$(HelloMacPkgIdentifier)' != ''">$(HelloMacPkgIdentifier)</BundlerMacPkgIdentifier>
    <BundlerMacPkgVersion Condition="'$(HelloMacPkgVersion)' != ''">$(HelloMacPkgVersion)</BundlerMacPkgVersion>
    <BundlerMacPkgInstallLocation Condition="'$(HelloMacPkgInstallLocation)' != ''">$(HelloMacPkgInstallLocation)</BundlerMacPkgInstallLocation>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <!-- 任意文件树载荷演示：该文件随 .app 一起进入 payload，落到 install-location 下的 support/ 目录。 -->
    <BundlerPkgPayload Include="Assets/readme.txt" Destination="support/readme.txt" />
  </ItemGroup>
</Project>
