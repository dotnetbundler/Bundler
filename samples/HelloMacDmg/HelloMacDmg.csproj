<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloMacDmg：DotNet.Bundler macOS .dmg 全功能演示示例。
    压缩格式 / 卷名 / 自动产出的 .app 中间产物等所有当前公开能力都可用下方旋钮演示；
    .app 自身的完整旋钮请参考 samples/HelloMacApp（dmg 打包会先生成同样的 .app）。
    变体命令见 mac-dmg-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <AssemblyName>HelloMacDmg</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <!-- dmg 请求会让规划器自动先产出 .app 中间产物，再打 .dmg。 -->
    <BundlerFormats>dmg</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.hellomacdmg</BundlerIdentifier>
    <BundlerProductName>Hello Mac DMG</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler macOS .dmg demonstration sample.</BundlerDescription>
    <BundlerCopyright>Copyright DotNet.Bundler Samples</BundlerCopyright>

    <!-- .dmg 公开旋钮：压缩格式（Udzo/Ulmo/Udbz，默认 Ulmo）与卷名（默认=产品名）。 -->
    <BundlerMacDmgCompression Condition="'$(HelloMacDmgCompression)' != ''">$(HelloMacDmgCompression)</BundlerMacDmgCompression>
    <BundlerMacDmgVolumeName Condition="'$(HelloMacDmgVolumeName)' != ''">$(HelloMacDmgVolumeName)</BundlerMacDmgVolumeName>

    <!-- Finder 布局与品牌（MAC-DMG-2）：默认演示背景图+卷图标；HelloMacDmgSkipWindowLayout 可整体跳过。 -->
    <BundlerMacDmgSkipWindowLayout Condition="'$(HelloMacDmgSkipWindowLayout)' != ''">$(HelloMacDmgSkipWindowLayout)</BundlerMacDmgSkipWindowLayout>
    <BundlerMacDmgWindowX Condition="'$(HelloMacDmgWindowX)' != ''">$(HelloMacDmgWindowX)</BundlerMacDmgWindowX>
    <BundlerMacDmgWindowY Condition="'$(HelloMacDmgWindowY)' != ''">$(HelloMacDmgWindowY)</BundlerMacDmgWindowY>
    <BundlerMacDmgWindowWidth Condition="'$(HelloMacDmgWindowWidth)' != ''">$(HelloMacDmgWindowWidth)</BundlerMacDmgWindowWidth>
    <BundlerMacDmgWindowHeight Condition="'$(HelloMacDmgWindowHeight)' != ''">$(HelloMacDmgWindowHeight)</BundlerMacDmgWindowHeight>
    <BundlerMacDmgAppIconX Condition="'$(HelloMacDmgAppIconX)' != ''">$(HelloMacDmgAppIconX)</BundlerMacDmgAppIconX>
    <BundlerMacDmgAppIconY Condition="'$(HelloMacDmgAppIconY)' != ''">$(HelloMacDmgAppIconY)</BundlerMacDmgAppIconY>
    <BundlerMacDmgApplicationsIconX Condition="'$(HelloMacDmgApplicationsIconX)' != ''">$(HelloMacDmgApplicationsIconX)</BundlerMacDmgApplicationsIconX>
    <BundlerMacDmgApplicationsIconY Condition="'$(HelloMacDmgApplicationsIconY)' != ''">$(HelloMacDmgApplicationsIconY)</BundlerMacDmgApplicationsIconY>
    <BundlerMacDmgIconSize Condition="'$(HelloMacDmgIconSize)' != ''">$(HelloMacDmgIconSize)</BundlerMacDmgIconSize>
    <BundlerMacDmgBackgroundFile Condition="'$(HelloMacDmgBackgroundFile)' != ''">$(HelloMacDmgBackgroundFile)</BundlerMacDmgBackgroundFile>
    <BundlerMacDmgBackgroundFile Condition="'$(HelloMacDmgBackgroundFile)' == ''">$(MSBuildThisFileDirectory)Assets/bg.png</BundlerMacDmgBackgroundFile>
    <BundlerMacDmgVolumeIconFile Condition="'$(HelloMacDmgVolumeIconFile)' != ''">$(HelloMacDmgVolumeIconFile)</BundlerMacDmgVolumeIconFile>
    <BundlerMacDmgVolumeIconFile Condition="'$(HelloMacDmgVolumeIconFile)' == ''">$(MSBuildThisFileDirectory)Assets/volume.icns</BundlerMacDmgVolumeIconFile>

    <!-- EULA（MAC-DMG-3）：HelloMacDmgLicenseFile 默认演示 Assets/eula.txt，挂载时弹许可面板；
         置空（-p:HelloMacDmgLicenseFile=none）则不注入 SLA。也可改指 .rtf 文件。 -->
    <BundlerLicenseFile Condition="'$(HelloMacDmgLicenseFile)' == 'none'"></BundlerLicenseFile>
    <BundlerLicenseFile Condition="'$(HelloMacDmgLicenseFile)' != '' and '$(HelloMacDmgLicenseFile)' != 'none'">$(HelloMacDmgLicenseFile)</BundlerLicenseFile>
    <BundlerLicenseFile Condition="'$(HelloMacDmgLicenseFile)' == ''">$(MSBuildThisFileDirectory)Assets/eula.txt</BundlerLicenseFile>

    <!-- DMG 本体签名（MAC-DMG-3）：identity（"-"=ad-hoc）与临时钥匙串证书互斥；
         ad-hoc 组合可直接演示（HelloMacDmgDmgSignIdentity=-），真实证书走 identity 或 p12+密码。 -->
    <BundlerMacDmgSignIdentity Condition="'$(HelloMacDmgDmgSignIdentity)' != ''">$(HelloMacDmgDmgSignIdentity)</BundlerMacDmgSignIdentity>
    <BundlerMacDmgSignCertificatePath Condition="'$(HelloMacDmgDmgSignCertificatePath)' != ''">$(HelloMacDmgDmgSignCertificatePath)</BundlerMacDmgSignCertificatePath>
    <BundlerMacDmgSignCertificatePassword Condition="'$(HelloMacDmgDmgSignCertificatePassword)' != ''">$(HelloMacDmgDmgSignCertificatePassword)</BundlerMacDmgSignCertificatePassword>

    <!-- .app 侧旋钮：与 HelloMacApp 相同，可搭配演示。 -->
    <BundlerMacAppBundleName>HelloMacDmg</BundlerMacAppBundleName>
    <BundlerMacAppDisplayName>Hello Mac DMG</BundlerMacAppDisplayName>
    <BundlerMacAppMinimumSystemVersion Condition="'$(HelloMacDmgMinSystemVersion)' != ''">$(HelloMacDmgMinSystemVersion)</BundlerMacAppMinimumSystemVersion>
    <BundlerMacAppSignIdentity Condition="'$(HelloMacDmgSignIdentity)' != ''">$(HelloMacDmgSignIdentity)</BundlerMacAppSignIdentity>
    <BundlerMacAppHardenedRuntime Condition="'$(HelloMacDmgHardenedRuntime)' != ''">$(HelloMacDmgHardenedRuntime)</BundlerMacAppHardenedRuntime>
    <BundlerMacAppEntitlementsFile Condition="'$(HelloMacDmgEntitlementsFile)' != ''">$(HelloMacDmgEntitlementsFile)</BundlerMacAppEntitlementsFile>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />

  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
  </ItemGroup>
</Project>
