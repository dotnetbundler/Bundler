<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloAlpineApkApp：DotNet.Bundler Alpine .apk 演示示例。
    默认 publish 即产出可安装的 .apk（托管写入器，任意宿主可构建，无需 apk/abuild）。
    全部公开旋钮可用下方 HelloAlpineApk* 属性变体演示；命令见 alpine-apk-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-musl-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <AssemblyName>HelloAlpineApkApp</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>alpineapk</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.helloalpineapkapp</BundlerIdentifier>
    <BundlerProductName>Hello Alpine Apk App</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler Alpine .apk demonstration sample.</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler/Bundler</BundlerHomepage>

    <!-- .apk 公开旋钮（APK-1/2 范围）：包名默认取产品名 kebab-case；
         release 默认 0（pkgver = <version>-r<release>）；license 按 SPDX 表达式写；
         builddate 默认 0；depend/provides/triggers 是分号列表；
         bin-link 默认包名，"none" 关闭。 -->
    <BundlerAlpineApkPackageName Condition="'$(HelloAlpineApkPackageName)' != ''">$(HelloAlpineApkPackageName)</BundlerAlpineApkPackageName>
    <BundlerAlpineApkRelease Condition="'$(HelloAlpineApkRelease)' != ''">$(HelloAlpineApkRelease)</BundlerAlpineApkRelease>
    <BundlerAlpineApkLicense>MIT</BundlerAlpineApkLicense>
    <BundlerAlpineApkLicense Condition="'$(HelloAlpineApkLicense)' != ''">$(HelloAlpineApkLicense)</BundlerAlpineApkLicense>
    <BundlerAlpineApkBuildDate Condition="'$(HelloAlpineApkBuildDate)' != ''">$(HelloAlpineApkBuildDate)</BundlerAlpineApkBuildDate>
    <!-- musl 自包含 .NET 运行时需要 libstdc++/libgcc；声明为依赖让 apk 自动解析。 -->
    <BundlerAlpineApkDepends>libstdc++;libgcc</BundlerAlpineApkDepends>
    <BundlerAlpineApkDepends Condition="'$(HelloAlpineApkDepends)' != ''">$(HelloAlpineApkDepends)</BundlerAlpineApkDepends>
    <BundlerAlpineApkProvides Condition="'$(HelloAlpineApkProvides)' != ''">$(HelloAlpineApkProvides)</BundlerAlpineApkProvides>
    <BundlerAlpineApkTriggers Condition="'$(HelloAlpineApkTriggers)' != ''">$(HelloAlpineApkTriggers)</BundlerAlpineApkTriggers>
    <BundlerAlpineApkBinLink Condition="'$(HelloAlpineApkBinLink)' != ''">$(HelloAlpineApkBinLink)</BundlerAlpineApkBinLink>

    <!-- APK-2 范围：六段安装脚本（非空 + LF 必备，入控制段 0755）。 -->
    <BundlerAlpineApkPostInstallScript>$(MSBuildThisFileDirectory)Assets/post-install.sh</BundlerAlpineApkPostInstallScript>
    <BundlerAlpineApkPostInstallScript Condition="'$(HelloAlpineApkPostInstallScript)' != ''">$(HelloAlpineApkPostInstallScript)</BundlerAlpineApkPostInstallScript>
    <BundlerAlpineApkPreDeinstallScript>$(MSBuildThisFileDirectory)Assets/pre-deinstall.sh</BundlerAlpineApkPreDeinstallScript>
    <BundlerAlpineApkPreDeinstallScript Condition="'$(HelloAlpineApkPreDeinstallScript)' != ''">$(HelloAlpineApkPreDeinstallScript)</BundlerAlpineApkPreDeinstallScript>
    <BundlerAlpineApkPreInstallScript Condition="'$(HelloAlpineApkPreInstallScript)' != ''">$(HelloAlpineApkPreInstallScript)</BundlerAlpineApkPreInstallScript>
    <BundlerAlpineApkPostDeinstallScript Condition="'$(HelloAlpineApkPostDeinstallScript)' != ''">$(HelloAlpineApkPostDeinstallScript)</BundlerAlpineApkPostDeinstallScript>
    <BundlerAlpineApkPreUpgradeScript Condition="'$(HelloAlpineApkPreUpgradeScript)' != ''">$(HelloAlpineApkPreUpgradeScript)</BundlerAlpineApkPreUpgradeScript>
    <BundlerAlpineApkPostUpgradeScript Condition="'$(HelloAlpineApkPostUpgradeScript)' != ''">$(HelloAlpineApkPostUpgradeScript)</BundlerAlpineApkPostUpgradeScript>

    <!-- APK-3 范围：可选 RSA 签名——供 PEM 私钥即前置 .SIGN.RSA 签名段，
         公钥按 <私钥文件名>.rsa.pub 落目标机 /etc/apk/keys/ 即视为已信任；
         只给口令不给密钥文件为配置错误，口令属秘密勿入库。 -->
    <BundlerAlpineApkSigningKeyFile Condition="'$(HelloAlpineApkSigningKeyFile)' != ''">$(HelloAlpineApkSigningKeyFile)</BundlerAlpineApkSigningKeyFile>
    <BundlerAlpineApkSigningKeyPassphrase Condition="'$(HelloAlpineApkSigningKeyPassphrase)' != ''">$(HelloAlpineApkSigningKeyPassphrase)</BundlerAlpineApkSigningKeyPassphrase>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.ProjectReference.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <!-- 资源项演示：随载荷落到 install-root 下的 docs/readme.txt。 -->
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
    <!-- 任意绝对路径映射演示：/etc 下的示例配置。 -->
    <BundlerAlpineApkFile Include="Assets/defaults.conf" Destination="/etc/hello-alpine-apk-app/defaults.conf" />
  </ItemGroup>
</Project>
