<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloRpmApp：DotNet.Bundler Linux .rpm 演示示例。
    默认 publish 即产出可安装的 .rpm（托管写入器，任意宿主可构建，无需 rpmbuild）。
    全部公开旋钮（package-name/version/release/epoch/architecture/vendor/
    install-root/bin-link 与 RPM-2 的 requires/provides/conflicts/obsoletes/
    recommends/suggests/license/group/url/categories/desktop-file/metainfo/
    changelog + BundlerRpmFile 映射）可用下方 HelloRpm* 属性变体演示；
    命令见 linux-rpm-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <AssemblyName>HelloRpmApp</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>rpm</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.hellorpmapp</BundlerIdentifier>
    <BundlerProductName>Hello Rpm App</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler Linux .rpm demonstration sample.</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler/Bundler</BundlerHomepage>

    <!-- .rpm 公开旋钮（LINUX-RPM-1 范围）：包名默认取产品名的 kebab-case；
         version 覆盖 rpm Version（禁含 '-'）；release 默认 1，预发布版自动映射为
         0.<n>.<label>（Fedora 惯例）；epoch 是独立数字（写入 EPOCH tag，不进文件名）；
         architecture 默认按 RID 映射（x64→x86_64、arm64→aarch64）可显式写 rpm 架构名；
         vendor 默认 Publisher→Identifier 回退；
         install-root 默认 /usr/lib/<包名>；bin-link 默认包名，"none" 关闭。 -->
    <BundlerRpmPackageName Condition="'$(HelloRpmPackageName)' != ''">$(HelloRpmPackageName)</BundlerRpmPackageName>
    <BundlerRpmVersion Condition="'$(HelloRpmVersion)' != ''">$(HelloRpmVersion)</BundlerRpmVersion>
    <BundlerRpmRelease Condition="'$(HelloRpmRelease)' != ''">$(HelloRpmRelease)</BundlerRpmRelease>
    <BundlerRpmEpoch Condition="'$(HelloRpmEpoch)' != ''">$(HelloRpmEpoch)</BundlerRpmEpoch>
    <BundlerRpmArchitecture Condition="'$(HelloRpmArchitecture)' != ''">$(HelloRpmArchitecture)</BundlerRpmArchitecture>
    <BundlerRpmVendor Condition="'$(HelloRpmVendor)' != ''">$(HelloRpmVendor)</BundlerRpmVendor>
    <BundlerRpmInstallRoot Condition="'$(HelloRpmInstallRoot)' != ''">$(HelloRpmInstallRoot)</BundlerRpmInstallRoot>
    <BundlerRpmBinLink Condition="'$(HelloRpmBinLink)' != ''">$(HelloRpmBinLink)</BundlerRpmBinLink>
    <!-- RPM-2 元数据旋钮：关系字段按分号列表透传（命令行传参用 %3B 转义分号）；
         License 惯例上写 SPDX 表达式；Group 现代包可留空；Url 默认取 BundlerHomepage。 -->
    <BundlerRpmRequires Condition="'$(HelloRpmRequires)' != ''">$(HelloRpmRequires)</BundlerRpmRequires>
    <BundlerRpmProvides Condition="'$(HelloRpmProvides)' != ''">$(HelloRpmProvides)</BundlerRpmProvides>
    <BundlerRpmConflicts Condition="'$(HelloRpmConflicts)' != ''">$(HelloRpmConflicts)</BundlerRpmConflicts>
    <BundlerRpmObsoletes Condition="'$(HelloRpmObsoletes)' != ''">$(HelloRpmObsoletes)</BundlerRpmObsoletes>
    <BundlerRpmRecommends Condition="'$(HelloRpmRecommends)' != ''">$(HelloRpmRecommends)</BundlerRpmRecommends>
    <BundlerRpmSuggests Condition="'$(HelloRpmSuggests)' != ''">$(HelloRpmSuggests)</BundlerRpmSuggests>
    <BundlerRpmLicense>MIT</BundlerRpmLicense>
    <BundlerRpmLicense Condition="'$(HelloRpmLicense)' != ''">$(HelloRpmLicense)</BundlerRpmLicense>
    <BundlerRpmGroup Condition="'$(HelloRpmGroup)' != ''">$(HelloRpmGroup)</BundlerRpmGroup>
    <BundlerRpmUrl Condition="'$(HelloRpmUrl)' != ''">$(HelloRpmUrl)</BundlerRpmUrl>
    <BundlerRpmCategories>Utility;Development</BundlerRpmCategories>
    <BundlerRpmCategories Condition="'$(HelloRpmCategories)' != ''">$(HelloRpmCategories)</BundlerRpmCategories>
    <BundlerRpmDesktopFile Condition="'$(HelloRpmDesktopFile)' != ''">$(HelloRpmDesktopFile)</BundlerRpmDesktopFile>
    <BundlerRpmMetainfoFile>$(MSBuildThisFileDirectory)Assets/app.metainfo.xml</BundlerRpmMetainfoFile>
    <BundlerRpmMetainfoFile Condition="'$(HelloRpmMetainfoFile)' != ''">$(HelloRpmMetainfoFile)</BundlerRpmMetainfoFile>
    <BundlerRpmChangelogFile>$(MSBuildThisFileDirectory)Assets/CHANGELOG.md</BundlerRpmChangelogFile>
    <BundlerRpmConfigFiles Condition="'$(HelloRpmConfigFiles)' != ''">$(HelloRpmConfigFiles)</BundlerRpmConfigFiles>
    <BundlerRpmSystemdServiceFile Condition="'$(HelloRpmSystemdServiceFile)' != ''">$(HelloRpmSystemdServiceFile)</BundlerRpmSystemdServiceFile>
    <BundlerRpmPostInstallFile Condition="'$(HelloRpmPostInstallFile)' != ''">$(HelloRpmPostInstallFile)</BundlerRpmPostInstallFile>
    <BundlerRpmPreInstallFile Condition="'$(HelloRpmPreInstallFile)' != ''">$(HelloRpmPreInstallFile)</BundlerRpmPreInstallFile>
    <BundlerRpmPreUninstallFile Condition="'$(HelloRpmPreUninstallFile)' != ''">$(HelloRpmPreUninstallFile)</BundlerRpmPreUninstallFile>
    <BundlerRpmPostUninstallFile Condition="'$(HelloRpmPostUninstallFile)' != ''">$(HelloRpmPostUninstallFile)</BundlerRpmPostUninstallFile>
    <BundlerRpmPostInstallProgram Condition="'$(HelloRpmPostInstallProgram)' != ''">$(HelloRpmPostInstallProgram)</BundlerRpmPostInstallProgram>
    <BundlerRpmCompression Condition="'$(HelloRpmCompression)' != ''">$(HelloRpmCompression)</BundlerRpmCompression>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets/LICENSE.txt</BundlerLicenseFile>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <!-- 资源项演示：随载荷落到 install-root 下的 docs/readme.txt。 -->
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
    <!-- freedesktop 集成演示：图标落 hicolor 树、.desktop 由后端生成
         （Exec 取 /usr/bin 链接名、MimeType 合并 FileAssociation/UrlProtocol）。 -->
    <BundlerIcon Include="Assets/icon48.png" />
    <BundlerIcon Include="Assets/icon@2x.png" />
    <BundlerFileAssociation Include=".hello-rpm" Name="Hello rpm document"
        MimeType="application/x-hello-rpm" />
    <BundlerUrlProtocol Include="hello-rpm" Name="Hello rpm" />
    <!-- 任意绝对路径映射演示：/etc/hello-rpm-app/defaults.conf。 -->
    <BundlerRpmFile Include="Assets/defaults.conf" Destination="/etc/hello-rpm-app/defaults.conf" />
  </ItemGroup>
</Project>
