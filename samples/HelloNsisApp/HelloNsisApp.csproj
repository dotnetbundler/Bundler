<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HelloBundledApp</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <HelloNsisAppInstallMode Condition="'$(HelloNsisAppInstallMode)' == ''">currentUser</HelloNsisAppInstallMode>
    <HelloNsisAppAllowDowngrades Condition="'$(HelloNsisAppAllowDowngrades)' == ''">false</HelloNsisAppAllowDowngrades>
    <HelloNsisAppLegacyMsiProductCodes Condition="'$(HelloNsisAppLegacyMsiProductCodes)' == ''"></HelloNsisAppLegacyMsiProductCodes>
    <HelloNsisAppLegacyMsiUpgradeCodes Condition="'$(HelloNsisAppLegacyMsiUpgradeCodes)' == ''"></HelloNsisAppLegacyMsiUpgradeCodes>
    <HelloNsisAppSigningPfxFile Condition="'$(HelloNsisAppSigningPfxFile)' == ''"></HelloNsisAppSigningPfxFile>
    <HelloNsisAppSigningPfxPasswordEnvironmentVariable Condition="'$(HelloNsisAppSigningPfxPasswordEnvironmentVariable)' == ''"></HelloNsisAppSigningPfxPasswordEnvironmentVariable>
    <HelloNsisAppSigningCertificateThumbprint Condition="'$(HelloNsisAppSigningCertificateThumbprint)' == ''"></HelloNsisAppSigningCertificateThumbprint>
    <HelloNsisAppSigningTimestampUrl Condition="'$(HelloNsisAppSigningTimestampUrl)' == ''"></HelloNsisAppSigningTimestampUrl>
    <HelloNsisAppSigningCommand Condition="'$(HelloNsisAppSigningCommand)' == ''"></HelloNsisAppSigningCommand>
    <HelloNsisAppSigningCommandArguments Condition="'$(HelloNsisAppSigningCommandArguments)' == ''"></HelloNsisAppSigningCommandArguments>
    <_HelloNsisAppToolsetArchive>$(MSBuildThisFileDirectory)..\..\third_party\nsis\nsis-toolset-3.12-r1.zip</_HelloNsisAppToolsetArchive>
    <_HelloNsisAppArtworkDirectory>$(BaseIntermediateOutputPath)sample-nsis-artwork\</_HelloNsisAppArtworkDirectory>
    <_HelloNsisAppArtworkRoot>$(_HelloNsisAppArtworkDirectory)common\Contrib\Graphics</_HelloNsisAppArtworkRoot>
    <_HelloNsisAppArtworkMarker>$(_HelloNsisAppArtworkDirectory).complete</_HelloNsisAppArtworkMarker>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>nsis</BundlerFormats>
    <BundlerIdentifier>com.example.hellobundledapp</BundlerIdentifier>
    <BundlerProductName>Hello Bundled App</BundlerProductName>
    <BundlerPublisher>Bundler Contributors</BundlerPublisher>
    <BundlerDescription>演示 DotNet.Bundler 当前支持的 Windows NSIS 功能。</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler</BundlerHomepage>
    <BundlerCopyright>Copyright © DotNet.Bundler contributors</BundlerCopyright>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets\license.txt</BundlerLicenseFile>
    <BundlerNsisInstallMode>$(HelloNsisAppInstallMode)</BundlerNsisInstallMode>
    <BundlerNsisCompression>zlib</BundlerNsisCompression>
    <BundlerNsisLanguages>English;SimpChinese;Japanese</BundlerNsisLanguages>
    <BundlerNsisDisplayLanguageSelector>true</BundlerNsisDisplayLanguageSelector>
    <BundlerNsisInstallerIcon>$(_HelloNsisAppArtworkRoot)\Icons\modern-install-colorful.ico</BundlerNsisInstallerIcon>
    <BundlerNsisUninstallerIcon>$(_HelloNsisAppArtworkRoot)\Icons\modern-uninstall-colorful.ico</BundlerNsisUninstallerIcon>
    <BundlerNsisHeaderImage>$(_HelloNsisAppArtworkRoot)\Header\nsis3-grey.bmp</BundlerNsisHeaderImage>
    <BundlerNsisUninstallerHeaderImage>$(_HelloNsisAppArtworkRoot)\Header\orange-uninstall.bmp</BundlerNsisUninstallerHeaderImage>
    <BundlerNsisSidebarImage>$(_HelloNsisAppArtworkRoot)\Wizard\nsis3-grey.bmp</BundlerNsisSidebarImage>
    <BundlerNsisInstallerHooks>$(MSBuildThisFileDirectory)Assets\installer-hooks.nsh</BundlerNsisInstallerHooks>
    <BundlerNsisAllowDowngrades>$(HelloNsisAppAllowDowngrades)</BundlerNsisAllowDowngrades>
    <BundlerNsisShortcutDesktop>true</BundlerNsisShortcutDesktop>
    <BundlerNsisShortcutStartMenu>true</BundlerNsisShortcutStartMenu>
    <BundlerNsisShortcutArguments>--from-shortcut &quot;你好 world&quot;</BundlerNsisShortcutArguments>
    <BundlerNsisShortcutWorkingDirectory>演示资源</BundlerNsisShortcutWorkingDirectory>
    <BundlerNsisShortcutIcon>HelloBundledApp.exe</BundlerNsisShortcutIcon>
    <BundlerNsisShortcutAppUserModelId>com.example.hellobundledapp.desktop</BundlerNsisShortcutAppUserModelId>
    <BundlerNsisShortcutStartMenuFolder>Bundler Examples</BundlerNsisShortcutStartMenuFolder>
    <BundlerNsisShortcutLegacyProductNames>Hello Bundled App Preview</BundlerNsisShortcutLegacyProductNames>
    <BundlerNsisShortcutLegacyMainExecutables>HelloBundledApp.Preview.exe</BundlerNsisShortcutLegacyMainExecutables>
    <BundlerNsisLegacyMsiProductCodes>$(HelloNsisAppLegacyMsiProductCodes)</BundlerNsisLegacyMsiProductCodes>
    <BundlerNsisLegacyMsiUpgradeCodes>$(HelloNsisAppLegacyMsiUpgradeCodes)</BundlerNsisLegacyMsiUpgradeCodes>
    <BundlerWindowsSigningPfxFile>$(HelloNsisAppSigningPfxFile)</BundlerWindowsSigningPfxFile>
    <BundlerWindowsSigningPfxPasswordEnvironmentVariable>$(HelloNsisAppSigningPfxPasswordEnvironmentVariable)</BundlerWindowsSigningPfxPasswordEnvironmentVariable>
    <BundlerWindowsSigningCertificateThumbprint>$(HelloNsisAppSigningCertificateThumbprint)</BundlerWindowsSigningCertificateThumbprint>
    <BundlerWindowsSigningTimestampUrl>$(HelloNsisAppSigningTimestampUrl)</BundlerWindowsSigningTimestampUrl>
    <BundlerWindowsSigningCommand>$(HelloNsisAppSigningCommand)</BundlerWindowsSigningCommand>
    <Version>1.0.0</Version>
    <ApplicationIcon>$(_HelloNsisAppArtworkRoot)\Icons\modern-install-colorful.ico</ApplicationIcon>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerIcon Include="$(_HelloNsisAppArtworkRoot)\Icons\modern-install-colorful.ico" />
    <BundlerResource Include="Assets\demo-resource.txt" TargetPath="演示资源\说明.txt" />
    <BundlerResource Include="Assets\demo.hello" TargetPath="demo.hello" />
    <BundlerResource Include="Assets\运行深链接.cmd" TargetPath="运行深链接.cmd" />
    <BundlerFileAssociation Include="hello"
                            Name="Hello Bundled App 文档"
                            Description="Hello Bundled App 演示文档"
                            MimeType="application/x-hello-bundled-app" />
    <BundlerUrlProtocol Include="hello-bundled" Name="Hello Bundled App 深链接" />
    <BundlerNsisLanguageFile Include="Assets\SimpChinese.nsh" Language="SimpChinese" />
    <BundlerWindowsSigningCommandArgument Include="$(HelloNsisAppSigningCommandArguments)"
                                         Condition="'$(HelloNsisAppSigningCommandArguments)' != ''" />
  </ItemGroup>

  <Target Name="PrepareHelloNsisAppArtwork"
          BeforeTargets="CoreCompile;BundleDesktopApplication"
          Inputs="$(_HelloNsisAppToolsetArchive)"
          Outputs="$(_HelloNsisAppArtworkMarker)">
    <Unzip SourceFiles="$(_HelloNsisAppToolsetArchive)"
           DestinationFolder="$(_HelloNsisAppArtworkDirectory)"
           SkipUnchangedFiles="true" />
    <Touch Files="$(_HelloNsisAppArtworkMarker)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_HelloNsisAppArtworkDirectory)**\*" />
      <FileWrites Include="$(_HelloNsisAppArtworkMarker)" />
    </ItemGroup>
  </Target>

  <!-- 只清理这个示例从固定工具集生成的图片目录。 -->
  <Target Name="CleanHelloNsisAppArtwork" AfterTargets="Clean">
    <RemoveDir Directories="$(_HelloNsisAppArtworkDirectory)" />
  </Target>
</Project>
