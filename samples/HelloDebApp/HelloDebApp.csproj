<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloDebApp：DotNet.Bundler Linux .deb 演示示例。
    默认 publish 即产出可安装的 .deb（托管写入器，任意宿主可构建，无需 dpkg-deb）。
    全部公开旋钮（package-name/version/revision/epoch/architecture/maintainer/
    install-root/bin-link）可用下方 HelloDeb* 属性变体演示；命令见 linux-deb-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <AssemblyName>HelloDebApp</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>deb</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.hellodebapp</BundlerIdentifier>
    <BundlerProductName>Hello Deb App</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler Linux .deb demonstration sample.</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler/Bundler</BundlerHomepage>

    <!-- .deb 公开旋钮（LINUX-DEB-1 范围）：包名默认取产品名的 kebab-case；
         version 覆盖走完整 Debian 版本（可用 epoch:upstream-revision 直接给出）；
         revision 默认 1（空串=不附加）；epoch 是独立数字前缀；
         architecture 默认按 RID 映射（x64→amd64、arm64→arm64）可显式写 Debian 架构名；
         maintainer 默认 Publisher→Identifier 回退；
         install-root 默认 /usr/lib/<包名>；bin-link 默认包名，"none" 关闭。 -->
    <BundlerDebPackageName Condition="'$(HelloDebPackageName)' != ''">$(HelloDebPackageName)</BundlerDebPackageName>
    <BundlerDebVersion Condition="'$(HelloDebVersion)' != ''">$(HelloDebVersion)</BundlerDebVersion>
    <BundlerDebRevision Condition="'$(HelloDebRevision)' != ''">$(HelloDebRevision)</BundlerDebRevision>
    <BundlerDebEpoch Condition="'$(HelloDebEpoch)' != ''">$(HelloDebEpoch)</BundlerDebEpoch>
    <BundlerDebArchitecture Condition="'$(HelloDebArchitecture)' != ''">$(HelloDebArchitecture)</BundlerDebArchitecture>
    <BundlerDebMaintainer Condition="'$(HelloDebMaintainer)' != ''">$(HelloDebMaintainer)</BundlerDebMaintainer>
    <BundlerDebInstallRoot Condition="'$(HelloDebInstallRoot)' != ''">$(HelloDebInstallRoot)</BundlerDebInstallRoot>
    <BundlerDebBinLink Condition="'$(HelloDebBinLink)' != ''">$(HelloDebBinLink)</BundlerDebBinLink>

    <!-- LINUX-DEB-2 范围：关系字段纯透传（分号 = 子句分隔，逗号是 Debian 语法）；
         Section/Priority 覆盖（Priority 合法值 required/important/standard/optional/extra）；
         Categories 是 freedesktop 分号列表；
         DesktopFile/MetainfoFile/ChangelogFile 指向本地文件，DesktopFile 是整文件覆盖。 -->
    <BundlerDebDepends Condition="'$(HelloDebDepends)' != ''">$(HelloDebDepends)</BundlerDebDepends>
    <BundlerDebRecommends Condition="'$(HelloDebRecommends)' != ''">$(HelloDebRecommends)</BundlerDebRecommends>
    <BundlerDebProvides Condition="'$(HelloDebProvides)' != ''">$(HelloDebProvides)</BundlerDebProvides>
    <BundlerDebConflicts Condition="'$(HelloDebConflicts)' != ''">$(HelloDebConflicts)</BundlerDebConflicts>
    <BundlerDebReplaces Condition="'$(HelloDebReplaces)' != ''">$(HelloDebReplaces)</BundlerDebReplaces>
    <BundlerDebSection Condition="'$(HelloDebSection)' != ''">$(HelloDebSection)</BundlerDebSection>
    <BundlerDebPriority Condition="'$(HelloDebPriority)' != ''">$(HelloDebPriority)</BundlerDebPriority>
    <BundlerDebCategories>Utility;Development</BundlerDebCategories>
    <BundlerDebCategories Condition="'$(HelloDebCategories)' != ''">$(HelloDebCategories)</BundlerDebCategories>
    <BundlerDebDesktopFile Condition="'$(HelloDebDesktopFile)' != ''">$(HelloDebDesktopFile)</BundlerDebDesktopFile>
    <BundlerDebMetainfoFile>$(MSBuildThisFileDirectory)Assets/app.metainfo.xml</BundlerDebMetainfoFile>
    <BundlerDebMetainfoFile Condition="'$(HelloDebMetainfoFile)' != ''">$(HelloDebMetainfoFile)</BundlerDebMetainfoFile>
    <BundlerDebChangelogFile>$(MSBuildThisFileDirectory)Assets/CHANGELOG.md</BundlerDebChangelogFile>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets/LICENSE.txt</BundlerLicenseFile>

    <!-- LINUX-DEB-3 范围：维护者脚本（shebang + LF 必备，入 control 归档 0755）；
         SystemdServiceFile 托管 unit（装到 usr/lib/systemd/system/，postinst 自动合成
         daemon-reload 尾段——与自定义 postinst 合并）；Conffiles 显式登记
         （/etc 下的 BundlerDebFile 自动登记为 conffile）；Compression 仅支持 gzip。 -->
    <BundlerDebPostinstFile>$(MSBuildThisFileDirectory)Assets/postinst.sh</BundlerDebPostinstFile>
    <BundlerDebPostinstFile Condition="'$(HelloDebPostinstFile)' != ''">$(HelloDebPostinstFile)</BundlerDebPostinstFile>
    <BundlerDebPrermFile>$(MSBuildThisFileDirectory)Assets/prerm.sh</BundlerDebPrermFile>
    <BundlerDebPrermFile Condition="'$(HelloDebPrermFile)' != ''">$(HelloDebPrermFile)</BundlerDebPrermFile>
    <BundlerDebPostrmFile>$(MSBuildThisFileDirectory)Assets/postrm.sh</BundlerDebPostrmFile>
    <BundlerDebPostrmFile Condition="'$(HelloDebPostrmFile)' != ''">$(HelloDebPostrmFile)</BundlerDebPostrmFile>
    <BundlerDebPreinstFile Condition="'$(HelloDebPreinstFile)' != ''">$(HelloDebPreinstFile)</BundlerDebPreinstFile>
    <BundlerDebSystemdServiceFile Condition="'$(HelloDebSystemdServiceFile)' != ''">$(HelloDebSystemdServiceFile)</BundlerDebSystemdServiceFile>
    <BundlerDebConffiles Condition="'$(HelloDebConffiles)' != ''">$(HelloDebConffiles)</BundlerDebConffiles>
    <BundlerDebCompression Condition="'$(HelloDebCompression)' != ''">$(HelloDebCompression)</BundlerDebCompression>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <!-- 资源项演示：随载荷落到 install-root 下的 docs/readme.txt。 -->
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
    <!-- 图标（PNG，尺寸自动探测；文件名 @2x 后缀 → hicolor <WxH>@2 槽位）。 -->
    <BundlerIcon Include="Assets/icon48.png" />
    <BundlerIcon Include="Assets/icon@2x.png" />
    <!-- 文件关联与 URL 协议 → .desktop 的 MimeType（含 x-scheme-handler/ 前缀）。 -->
    <BundlerFileAssociation Include=".hellodeb" Name="Hello Deb document"
        Description="HelloDebApp sample document" MimeType="application/x-hellodeb" />
    <BundlerUrlProtocol Include="hellodeb" Name="Hello Deb" />
    <!-- BundlerDebFile：任意文件落进包内绝对路径（含文件名，禁止相对路径与 ..）。 -->
    <BundlerDebFile Include="Assets/defaults.conf" Destination="/etc/hello-deb-app/defaults.conf" />
  </ItemGroup>
</Project>
