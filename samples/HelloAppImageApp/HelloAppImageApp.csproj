<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HelloAppImageApp：DotNet.Bundler Linux .AppImage 演示示例。
    默认 publish 即产出可直接运行的 .AppImage（后端内嵌 appimagetool + type2 runtime，
    仅 Linux 宿主可构建；x86_64/aarch64 产物均可产出）。
    全部公开旋钮（package-name/version/architecture/install-root/bin-link/
    icon-file/desktop-file/categories/metainfo-file）可用下方 HelloAppImage*
    属性变体演示；命令见 linux-appimage-sample.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <AssemblyName>HelloAppImageApp</AssemblyName>
    <Version>1.0.0</Version>

    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>appimage</BundlerFormats>
    <BundlerIdentifier>com.dotnetbundler.helloappimageapp</BundlerIdentifier>
    <BundlerProductName>Hello AppImage App</BundlerProductName>
    <BundlerPublisher>DotNet.Bundler Samples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler Linux .AppImage demonstration sample.</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler/Bundler</BundlerHomepage>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets/LICENSE.txt</BundlerLicenseFile>

    <!-- .AppImage 公开旋钮（LINUX-APPIMAGE-1 范围）：包名默认取产品名的 kebab-case；
         version 原样进入文件名（无 EVR 限制）；architecture 默认按 RID 映射
         （x64→x86_64、arm64→aarch64），用嵌入 runtime 支持交叉产出；
         install-root 默认 usr/lib/<包名>；bin-link 默认包名，"none" 关闭；
         icon-file 覆盖根图标（缺省取 hicolor 最大方图，全无则用内置默认 PNG）；
         desktop-file 整文件覆盖生成的 .desktop；categories 缺省 Utility；
         metainfo-file 落 usr/share/metainfo/。压缩固定 zstd（内嵌 appimagetool
         的 mksquashfs 仅支持 zstd）。 -->
    <BundlerAppImagePackageName Condition="'$(HelloAppImagePackageName)' != ''">$(HelloAppImagePackageName)</BundlerAppImagePackageName>
    <BundlerAppImageVersion Condition="'$(HelloAppImageVersion)' != ''">$(HelloAppImageVersion)</BundlerAppImageVersion>
    <BundlerAppImageArchitecture Condition="'$(HelloAppImageArchitecture)' != ''">$(HelloAppImageArchitecture)</BundlerAppImageArchitecture>
    <BundlerAppImageInstallRoot Condition="'$(HelloAppImageInstallRoot)' != ''">$(HelloAppImageInstallRoot)</BundlerAppImageInstallRoot>
    <BundlerAppImageBinLink Condition="'$(HelloAppImageBinLink)' != ''">$(HelloAppImageBinLink)</BundlerAppImageBinLink>
    <BundlerAppImageIconFile Condition="'$(HelloAppImageIconFile)' != ''">$(HelloAppImageIconFile)</BundlerAppImageIconFile>
    <BundlerAppImageDesktopFile Condition="'$(HelloAppImageDesktopFile)' != ''">$(HelloAppImageDesktopFile)</BundlerAppImageDesktopFile>
    <BundlerAppImageCategories>Utility;Development</BundlerAppImageCategories>
    <BundlerAppImageCategories Condition="'$(HelloAppImageCategories)' != ''">$(HelloAppImageCategories)</BundlerAppImageCategories>
    <BundlerAppImageMetainfoFile>$(MSBuildThisFileDirectory)Assets/app.metainfo.xml</BundlerAppImageMetainfoFile>
    <BundlerAppImageMetainfoFile Condition="'$(HelloAppImageMetainfoFile)' != ''">$(HelloAppImageMetainfoFile)</BundlerAppImageMetainfoFile>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <!-- 资源项演示：随载荷落到 install-root 下的 docs/readme.txt。 -->
    <BundlerResource Include="Assets/readme.txt" TargetPath="docs/readme.txt" />
    <!-- freedesktop 集成演示：图标落 hicolor 树、.desktop 由后端生成
         （Exec 取 usr/bin 链接名、MimeType 合并 FileAssociation/UrlProtocol）。 -->
    <BundlerIcon Include="Assets/icon48.png" />
    <BundlerIcon Include="Assets/icon@2x.png" />
    <BundlerFileAssociation Include=".hello-appimage" Name="Hello AppImage document"
        MimeType="application/x-hello-appimage" />
    <BundlerUrlProtocol Include="hello-appimage" Name="Hello AppImage" />
  </ItemGroup>
</Project>
