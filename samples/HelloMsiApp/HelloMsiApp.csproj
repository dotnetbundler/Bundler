<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <BundlerUseRepositoryPackageSource>true</BundlerUseRepositoryPackageSource>
    <BundlerOutputPath>$(MSBuildProjectDirectory)\artifacts\feature-demo</BundlerOutputPath>
    <HelloMsiAppInstallScope Condition="'$(HelloMsiAppInstallScope)' == ''">currentUser</HelloMsiAppInstallScope>
    <HelloMsiAppLanguage Condition="'$(HelloMsiAppLanguage)' == ''">en-US</HelloMsiAppLanguage>
    <HelloMsiAppLanguages Condition="'$(HelloMsiAppLanguages)' == ''"></HelloMsiAppLanguages>
    <HelloMsiAppFipsCompliant Condition="'$(HelloMsiAppFipsCompliant)' == ''">false</HelloMsiAppFipsCompliant>
    <HelloMsiAppInstallDirectorySelection Condition="'$(HelloMsiAppInstallDirectorySelection)' == ''">true</HelloMsiAppInstallDirectorySelection>
    <HelloMsiAppAddToPath Condition="'$(HelloMsiAppAddToPath)' == ''">true</HelloMsiAppAddToPath>
    <HelloMsiAppUninstallShortcut Condition="'$(HelloMsiAppUninstallShortcut)' == ''">true</HelloMsiAppUninstallShortcut>
    <HelloMsiAppLaunchAfterInstall Condition="'$(HelloMsiAppLaunchAfterInstall)' == ''">true</HelloMsiAppLaunchAfterInstall>
    <HelloMsiAppBannerBitmap Condition="'$(HelloMsiAppBannerBitmap)' == ''">$(MSBuildThisFileDirectory)Assets\banner.bmp</HelloMsiAppBannerBitmap>
    <HelloMsiAppDialogBitmap Condition="'$(HelloMsiAppDialogBitmap)' == ''">$(MSBuildThisFileDirectory)Assets\dialog.bmp</HelloMsiAppDialogBitmap>
    <HelloMsiAppMsiVersion Condition="'$(HelloMsiAppMsiVersion)' == ''"></HelloMsiAppMsiVersion>
    <HelloMsiAppAllowDowngrades Condition="'$(HelloMsiAppAllowDowngrades)' == ''">false</HelloMsiAppAllowDowngrades>
    <HelloMsiAppSigningPfxFile Condition="'$(HelloMsiAppSigningPfxFile)' == ''"></HelloMsiAppSigningPfxFile>
    <HelloMsiAppSigningPfxPasswordEnvironmentVariable Condition="'$(HelloMsiAppSigningPfxPasswordEnvironmentVariable)' == ''"></HelloMsiAppSigningPfxPasswordEnvironmentVariable>
    <HelloMsiAppSigningCertificateThumbprint Condition="'$(HelloMsiAppSigningCertificateThumbprint)' == ''"></HelloMsiAppSigningCertificateThumbprint>
    <HelloMsiAppSigningTimestampUrl Condition="'$(HelloMsiAppSigningTimestampUrl)' == ''"></HelloMsiAppSigningTimestampUrl>
    <HelloMsiAppSigningCommand Condition="'$(HelloMsiAppSigningCommand)' == ''"></HelloMsiAppSigningCommand>
    <HelloMsiAppSigningCommandArguments Condition="'$(HelloMsiAppSigningCommandArguments)' == ''"></HelloMsiAppSigningCommandArguments>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>msi</BundlerFormats>
    <BundlerProductName>Hello MSI App</BundlerProductName>
    <BundlerIdentifier>com.example.hellomsiapp</BundlerIdentifier>
    <BundlerVersion>1.0.0</BundlerVersion>
    <Version>1.0.0</Version>
    <BundlerPublisher>Bundler Examples</BundlerPublisher>
    <BundlerDescription>Demonstrates current DotNet.Bundler Windows MSI features.</BundlerDescription>
    <BundlerHomepage>https://github.com/dotnetbundler</BundlerHomepage>
    <BundlerCopyright>Copyright © DotNet.Bundler contributors</BundlerCopyright>
    <BundlerLicenseFile>$(MSBuildThisFileDirectory)Assets\demo-license.rtf</BundlerLicenseFile>
    <BundlerWixInstallScope>$(HelloMsiAppInstallScope)</BundlerWixInstallScope>
    <BundlerWixLanguage>$(HelloMsiAppLanguage)</BundlerWixLanguage>
    <BundlerWixLanguages>$(HelloMsiAppLanguages)</BundlerWixLanguages>
    <BundlerWixFipsCompliant>$(HelloMsiAppFipsCompliant)</BundlerWixFipsCompliant>
    <BundlerWixMsiVersion>$(HelloMsiAppMsiVersion)</BundlerWixMsiVersion>
    <BundlerWixAllowDowngrades>$(HelloMsiAppAllowDowngrades)</BundlerWixAllowDowngrades>
    <BundlerWixCodepage>0</BundlerWixCodepage>
    <BundlerWixStartMenuShortcut>true</BundlerWixStartMenuShortcut>
    <BundlerWixDesktopShortcut>true</BundlerWixDesktopShortcut>
    <BundlerWixInstallDirectorySelection>$(HelloMsiAppInstallDirectorySelection)</BundlerWixInstallDirectorySelection>
    <BundlerWixBannerBitmap>$(HelloMsiAppBannerBitmap)</BundlerWixBannerBitmap>
    <BundlerWixDialogBitmap>$(HelloMsiAppDialogBitmap)</BundlerWixDialogBitmap>
    <BundlerWixAddToPath>$(HelloMsiAppAddToPath)</BundlerWixAddToPath>
    <BundlerWixUninstallShortcut>$(HelloMsiAppUninstallShortcut)</BundlerWixUninstallShortcut>
    <BundlerWixLaunchAfterInstall>$(HelloMsiAppLaunchAfterInstall)</BundlerWixLaunchAfterInstall>
    <BundlerWindowsSigningPfxFile>$(HelloMsiAppSigningPfxFile)</BundlerWindowsSigningPfxFile>
    <BundlerWindowsSigningPfxPasswordEnvironmentVariable>$(HelloMsiAppSigningPfxPasswordEnvironmentVariable)</BundlerWindowsSigningPfxPasswordEnvironmentVariable>
    <BundlerWindowsSigningCertificateThumbprint>$(HelloMsiAppSigningCertificateThumbprint)</BundlerWindowsSigningCertificateThumbprint>
    <BundlerWindowsSigningTimestampUrl>$(HelloMsiAppSigningTimestampUrl)</BundlerWindowsSigningTimestampUrl>
    <BundlerWindowsSigningCommand>$(HelloMsiAppSigningCommand)</BundlerWindowsSigningCommand>
    <ApplicationIcon>$(MSBuildThisFileDirectory)Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Bundler.LocalPackages.props', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" PrivateAssets="all" />
    <BundlerIcon Include="Assets\app.ico" />
    <BundlerWixLanguageFile Include="Assets\locale-zh-cn.wxl" Language="zh-CN"
        Condition="$(HelloMsiAppLanguages.Contains('zh-CN')) or $(HelloMsiAppLanguage.Contains('zh-CN'))" />
    <BundlerResource Include="Assets\demo-resource.txt" TargetPath="DemoResources\Readme.txt" />
    <BundlerResource Include="Assets\demo.hellomsi" TargetPath="demo.hellomsi" />
    <BundlerResource Include="Assets\open-link.cmd" TargetPath="open-link.cmd" />
    <BundlerFileAssociation Include=".hellomsi">
      <Name>Hello MSI document</Name>
      <Description>Hello MSI App sample document</Description>
      <MimeType>application/x-hellomsi</MimeType>
    </BundlerFileAssociation>
    <BundlerUrlProtocol Include="hello-msi">
      <Name>Hello MSI link</Name>
    </BundlerUrlProtocol>
    <BundlerWindowsSigningCommandArgument Include="$(HelloMsiAppSigningCommandArguments)"
                                         Condition="'$(HelloMsiAppSigningCommandArguments)' != ''" />
  </ItemGroup>
</Project>
