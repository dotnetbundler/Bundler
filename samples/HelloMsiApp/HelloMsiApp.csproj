<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BundlerEnabled>true</BundlerEnabled>
    <BundlerFormats>msi</BundlerFormats>
    <BundlerProductName>Hello MSI App</BundlerProductName>
    <BundlerIdentifier>com.example.hellomsiapp</BundlerIdentifier>
    <BundlerVersion>1.0.0</BundlerVersion>
    <BundlerPublisher>Bundler Examples</BundlerPublisher>
    <BundlerDescription>DotNet.Bundler MSI 最小示例</BundlerDescription>
    <BundlerWixCodepage>936</BundlerWixCodepage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.Bundler" Version="$(BundlerPackageVersion)" />
  </ItemGroup>
</Project>
