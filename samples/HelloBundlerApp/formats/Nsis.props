<Project>
  <!-- Nsis 后端全套公开旋钮。所有 HelloBundlerNsis* 属性均为变体演示传透。 -->
  <PropertyGroup>
    <HelloBundlerNsisInstallMode Condition="'$(HelloBundlerNsisInstallMode)' == ''">currentUser</HelloBundlerNsisInstallMode>
    <BundlerNsisInstallMode>$(HelloBundlerNsisInstallMode)</BundlerNsisInstallMode>
    <BundlerNsisCompression>zlib</BundlerNsisCompression>
    <BundlerNsisLanguages>English;SimpChinese;Japanese</BundlerNsisLanguages>
    <BundlerNsisDisplayLanguageSelector>true</BundlerNsisDisplayLanguageSelector>
    <!-- 工具链/数据目录/模板覆盖（专家旋钮，默认空走后端内嵌）。 -->
    <BundlerNsisToolsetArchivePath Condition="'$(HelloBundlerNsisToolsetArchivePath)' != ''">$(HelloBundlerNsisToolsetArchivePath)</BundlerNsisToolsetArchivePath>
    <BundlerNsisCompilerPath Condition="'$(HelloBundlerNsisCompilerPath)' != ''">$(HelloBundlerNsisCompilerPath)</BundlerNsisCompilerPath>
    <BundlerNsisDataDirectory Condition="'$(HelloBundlerNsisDataDirectory)' != ''">$(HelloBundlerNsisDataDirectory)</BundlerNsisDataDirectory>
    <BundlerNsisTemplate Condition="'$(HelloBundlerNsisTemplate)' != ''">$(HelloBundlerNsisTemplate)</BundlerNsisTemplate>
    <!-- 安装器外观素材：从固定第三方 NSIS 工具集解包（见下方 target）。 -->
    <_HelloBundlerNsisToolsetArchive>$(HelloBundlerAppAssets)..\..\..\third_party\nsis\nsis-toolset-3.12-r1.zip</_HelloBundlerNsisToolsetArchive>
    <_HelloBundlerNsisArtworkDirectory>$(BaseIntermediateOutputPath)sample-nsis-artwork\</_HelloBundlerNsisArtworkDirectory>
    <_HelloBundlerNsisArtworkRoot>$(_HelloBundlerNsisArtworkDirectory)common\Contrib\Graphics</_HelloBundlerNsisArtworkRoot>
    <_HelloBundlerNsisArtworkMarker>$(_HelloBundlerNsisArtworkDirectory).complete</_HelloBundlerNsisArtworkMarker>
    <BundlerNsisInstallerIcon>$(_HelloBundlerNsisArtworkRoot)\Icons\modern-install-colorful.ico</BundlerNsisInstallerIcon>
    <BundlerNsisUninstallerIcon>$(_HelloBundlerNsisArtworkRoot)\Icons\modern-uninstall-colorful.ico</BundlerNsisUninstallerIcon>
    <BundlerNsisHeaderImage>$(_HelloBundlerNsisArtworkRoot)\Header\nsis3-grey.bmp</BundlerNsisHeaderImage>
    <BundlerNsisUninstallerHeaderImage>$(_HelloBundlerNsisArtworkRoot)\Header\orange-uninstall.bmp</BundlerNsisUninstallerHeaderImage>
    <BundlerNsisSidebarImage>$(_HelloBundlerNsisArtworkRoot)\Wizard\nsis3-grey.bmp</BundlerNsisSidebarImage>
    <BundlerNsisInstallerHooks>$(HelloBundlerAppAssets)nsis\installer-hooks.nsh</BundlerNsisInstallerHooks>
    <!-- 升级/旧版迁移旋钮。 -->
    <BundlerNsisAllowDowngrades Condition="'$(HelloBundlerNsisAllowDowngrades)' != ''">$(HelloBundlerNsisAllowDowngrades)</BundlerNsisAllowDowngrades>
    <BundlerNsisLegacyMsiProductCodes Condition="'$(HelloBundlerNsisLegacyMsiProductCodes)' != ''">$(HelloBundlerNsisLegacyMsiProductCodes)</BundlerNsisLegacyMsiProductCodes>
    <BundlerNsisLegacyMsiUpgradeCodes Condition="'$(HelloBundlerNsisLegacyMsiUpgradeCodes)' != ''">$(HelloBundlerNsisLegacyMsiUpgradeCodes)</BundlerNsisLegacyMsiUpgradeCodes>
    <BundlerNsisLegacyMsiAutoDetect Condition="'$(HelloBundlerNsisLegacyMsiAutoDetect)' != ''">$(HelloBundlerNsisLegacyMsiAutoDetect)</BundlerNsisLegacyMsiAutoDetect>
    <BundlerNsisShortcutLegacyProductNames>Hello Bundler App Preview</BundlerNsisShortcutLegacyProductNames>
    <BundlerNsisShortcutLegacyMainExecutables>HelloBundlerApp.Preview.exe</BundlerNsisShortcutLegacyMainExecutables>
    <!-- 快捷方式旋钮。 -->
    <BundlerNsisShortcutDesktop>true</BundlerNsisShortcutDesktop>
    <BundlerNsisShortcutStartMenu>true</BundlerNsisShortcutStartMenu>
    <BundlerNsisShortcutArguments>--from-shortcut &quot;你好 world&quot;</BundlerNsisShortcutArguments>
    <!-- 工作目录必须指向最终载荷内存在的目录：中文目录在含 msi 的 publish 被 CJK 回退摘除，
         届时回退到常驻载荷的 docs。 -->
    <BundlerNsisShortcutWorkingDirectory Condition="!$([System.String]::Copy(';$(BundlerFormats);').Contains(';msi;'))">演示资源</BundlerNsisShortcutWorkingDirectory>
    <BundlerNsisShortcutWorkingDirectory Condition="$([System.String]::Copy(';$(BundlerFormats);').Contains(';msi;'))">docs</BundlerNsisShortcutWorkingDirectory>
    <BundlerNsisShortcutIcon>HelloBundlerApp.exe</BundlerNsisShortcutIcon>
    <BundlerNsisShortcutAppUserModelId>com.example.hellobundlerapp.desktop</BundlerNsisShortcutAppUserModelId>
    <BundlerNsisShortcutStartMenuFolder>Bundler Examples</BundlerNsisShortcutStartMenuFolder>
    <ApplicationIcon>$(_HelloBundlerNsisArtworkRoot)\Icons\modern-install-colorful.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <BundlerNsisLanguageFile Include="$(HelloBundlerAppAssets)nsis\SimpChinese.nsh" Language="SimpChinese" />
  </ItemGroup>

  <Target Name="PrepareHelloBundlerNsisArtwork"
          BeforeTargets="CoreCompile;BundleDesktopApplication"
          Inputs="$(_HelloBundlerNsisToolsetArchive)"
          Outputs="$(_HelloBundlerNsisArtworkMarker)">
    <Unzip SourceFiles="$(_HelloBundlerNsisToolsetArchive)"
           DestinationFolder="$(_HelloBundlerNsisArtworkDirectory)"
           SkipUnchangedFiles="true" />
    <Touch Files="$(_HelloBundlerNsisArtworkMarker)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_HelloBundlerNsisArtworkDirectory)**\*" />
      <FileWrites Include="$(_HelloBundlerNsisArtworkMarker)" />
    </ItemGroup>
  </Target>

  <!-- 只清理这个示例从固定工具集生成的图片目录。 -->
  <Target Name="CleanHelloBundlerNsisArtwork" AfterTargets="Clean">
    <RemoveDir Directories="$(_HelloBundlerNsisArtworkDirectory)" />
  </Target>
</Project>
