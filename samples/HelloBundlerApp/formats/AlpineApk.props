<Project>
  <!-- AlpineApk 后端全套公开旋钮。变体由 HelloBundlerApk* 传透；
       托管写入器，任意宿主可构建。 -->
  <PropertyGroup>
    <!-- 包名默认取产品名 kebab-case；version 覆盖 pkgver（默认取 Version）；
         architecture 默认按 RID 映射；origin 默认包名；description/url 默认
         BundlerDescription/BundlerHomepage；release 默认 0（pkgver=<version>-r<release>）；
         license 按 SPDX；builddate 默认 0；depend/provides/triggers 分号列表；
         bin-link 默认包名，"none" 关闭。 -->
    <BundlerAlpineApkPackageName Condition="'$(HelloBundlerApkPackageName)' != ''">$(HelloBundlerApkPackageName)</BundlerAlpineApkPackageName>
    <BundlerAlpineApkVersion Condition="'$(HelloBundlerApkVersion)' != ''">$(HelloBundlerApkVersion)</BundlerAlpineApkVersion>
    <BundlerAlpineApkRelease Condition="'$(HelloBundlerApkRelease)' != ''">$(HelloBundlerApkRelease)</BundlerAlpineApkRelease>
    <BundlerAlpineApkArchitecture Condition="'$(HelloBundlerApkArchitecture)' != ''">$(HelloBundlerApkArchitecture)</BundlerAlpineApkArchitecture>
    <BundlerAlpineApkOrigin Condition="'$(HelloBundlerApkOrigin)' != ''">$(HelloBundlerApkOrigin)</BundlerAlpineApkOrigin>
    <BundlerAlpineApkDescription Condition="'$(HelloBundlerApkDescription)' != ''">$(HelloBundlerApkDescription)</BundlerAlpineApkDescription>
    <BundlerAlpineApkUrl Condition="'$(HelloBundlerApkUrl)' != ''">$(HelloBundlerApkUrl)</BundlerAlpineApkUrl>
    <BundlerAlpineApkLicense>MIT</BundlerAlpineApkLicense>
    <BundlerAlpineApkLicense Condition="'$(HelloBundlerApkLicense)' != ''">$(HelloBundlerApkLicense)</BundlerAlpineApkLicense>
    <BundlerAlpineApkBuildDate Condition="'$(HelloBundlerApkBuildDate)' != ''">$(HelloBundlerApkBuildDate)</BundlerAlpineApkBuildDate>
    <!-- musl 自包含 .NET 运行时需要 libstdc++/libgcc；声明为依赖让 apk 自动解析。 -->
    <BundlerAlpineApkDepends>libstdc++;libgcc</BundlerAlpineApkDepends>
    <BundlerAlpineApkDepends Condition="'$(HelloBundlerApkDepends)' != ''">$(HelloBundlerApkDepends)</BundlerAlpineApkDepends>
    <BundlerAlpineApkProvides Condition="'$(HelloBundlerApkProvides)' != ''">$(HelloBundlerApkProvides)</BundlerAlpineApkProvides>
    <BundlerAlpineApkTriggers Condition="'$(HelloBundlerApkTriggers)' != ''">$(HelloBundlerApkTriggers)</BundlerAlpineApkTriggers>
    <BundlerAlpineApkBinLink Condition="'$(HelloBundlerApkBinLink)' != ''">$(HelloBundlerApkBinLink)</BundlerAlpineApkBinLink>

    <!-- 六段安装脚本（非空 + LF 必备，入控制段 0755）。 -->
    <BundlerAlpineApkPostInstallScript>$(HelloBundlerAppAssets)apk\post-install.sh</BundlerAlpineApkPostInstallScript>
    <BundlerAlpineApkPostInstallScript Condition="'$(HelloBundlerApkPostInstallScript)' != ''">$(HelloBundlerApkPostInstallScript)</BundlerAlpineApkPostInstallScript>
    <BundlerAlpineApkPreDeinstallScript>$(HelloBundlerAppAssets)apk\pre-deinstall.sh</BundlerAlpineApkPreDeinstallScript>
    <BundlerAlpineApkPreDeinstallScript Condition="'$(HelloBundlerApkPreDeinstallScript)' != ''">$(HelloBundlerApkPreDeinstallScript)</BundlerAlpineApkPreDeinstallScript>
    <BundlerAlpineApkPreInstallScript Condition="'$(HelloBundlerApkPreInstallScript)' != ''">$(HelloBundlerApkPreInstallScript)</BundlerAlpineApkPreInstallScript>
    <BundlerAlpineApkPostDeinstallScript Condition="'$(HelloBundlerApkPostDeinstallScript)' != ''">$(HelloBundlerApkPostDeinstallScript)</BundlerAlpineApkPostDeinstallScript>
    <BundlerAlpineApkPreUpgradeScript Condition="'$(HelloBundlerApkPreUpgradeScript)' != ''">$(HelloBundlerApkPreUpgradeScript)</BundlerAlpineApkPreUpgradeScript>
    <BundlerAlpineApkPostUpgradeScript Condition="'$(HelloBundlerApkPostUpgradeScript)' != ''">$(HelloBundlerApkPostUpgradeScript)</BundlerAlpineApkPostUpgradeScript>

    <!-- 可选 RSA 签名：供 PEM 私钥即前置 .SIGN.RSA 签名段；
         公钥按 <私钥文件名>.rsa.pub 落目标机 /etc/apk/keys/ 即视为已信任；
         只给口令不给密钥文件为配置错误，口令属秘密勿入库。 -->
    <BundlerAlpineApkSigningKeyFile Condition="'$(HelloBundlerApkSigningKeyFile)' != ''">$(HelloBundlerApkSigningKeyFile)</BundlerAlpineApkSigningKeyFile>
    <BundlerAlpineApkSigningKeyPassphrase Condition="'$(HelloBundlerApkSigningKeyPassphrase)' != ''">$(HelloBundlerApkSigningKeyPassphrase)</BundlerAlpineApkSigningKeyPassphrase>
  </PropertyGroup>

  <ItemGroup>
    <!-- 任意绝对路径映射演示：/etc/hello-alpine-apk-app/defaults.conf。 -->
    <BundlerAlpineApkFile Include="$(HelloBundlerAppAssets)apk\defaults.conf" Destination="/etc/hello-alpine-apk-app/defaults.conf" />
  </ItemGroup>
</Project>
