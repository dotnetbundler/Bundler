<Project>
  <!-- MacDmg（.dmg）后端全套公开旋钮。变体由 HelloBundlerDmg* 传透；
       打包 dmg 会先经 .app 中间产物，.app 旋钮见 MacApp.props。 -->
  <PropertyGroup>
    <!-- 压缩格式（Udzo/Ulmo/Udbz，默认 Ulmo）与卷名（默认=产品名）。 -->
    <BundlerMacDmgCompression Condition="'$(HelloBundlerDmgCompression)' != ''">$(HelloBundlerDmgCompression)</BundlerMacDmgCompression>
    <BundlerMacDmgVolumeName Condition="'$(HelloBundlerDmgVolumeName)' != ''">$(HelloBundlerDmgVolumeName)</BundlerMacDmgVolumeName>

    <!-- Finder 布局与品牌：默认演示背景图+卷图标；HelloBundlerDmgLayoutSkip 可整体跳过。 -->
    <BundlerMacDmgLayoutSkip Condition="'$(HelloBundlerDmgLayoutSkip)' != ''">$(HelloBundlerDmgLayoutSkip)</BundlerMacDmgLayoutSkip>
    <BundlerMacDmgLayoutWindowX Condition="'$(HelloBundlerDmgWindowX)' != ''">$(HelloBundlerDmgWindowX)</BundlerMacDmgLayoutWindowX>
    <BundlerMacDmgLayoutWindowY Condition="'$(HelloBundlerDmgWindowY)' != ''">$(HelloBundlerDmgWindowY)</BundlerMacDmgLayoutWindowY>
    <BundlerMacDmgLayoutWindowWidth Condition="'$(HelloBundlerDmgWindowWidth)' != ''">$(HelloBundlerDmgWindowWidth)</BundlerMacDmgLayoutWindowWidth>
    <BundlerMacDmgLayoutWindowHeight Condition="'$(HelloBundlerDmgWindowHeight)' != ''">$(HelloBundlerDmgWindowHeight)</BundlerMacDmgLayoutWindowHeight>
    <BundlerMacDmgLayoutAppIconX Condition="'$(HelloBundlerDmgAppIconX)' != ''">$(HelloBundlerDmgAppIconX)</BundlerMacDmgLayoutAppIconX>
    <BundlerMacDmgLayoutAppIconY Condition="'$(HelloBundlerDmgAppIconY)' != ''">$(HelloBundlerDmgAppIconY)</BundlerMacDmgLayoutAppIconY>
    <BundlerMacDmgLayoutApplicationsIconX Condition="'$(HelloBundlerDmgApplicationsIconX)' != ''">$(HelloBundlerDmgApplicationsIconX)</BundlerMacDmgLayoutApplicationsIconX>
    <BundlerMacDmgLayoutApplicationsIconY Condition="'$(HelloBundlerDmgApplicationsIconY)' != ''">$(HelloBundlerDmgApplicationsIconY)</BundlerMacDmgLayoutApplicationsIconY>
    <BundlerMacDmgLayoutIconSize Condition="'$(HelloBundlerDmgIconSize)' != ''">$(HelloBundlerDmgIconSize)</BundlerMacDmgLayoutIconSize>
    <BundlerMacDmgBackgroundFile Condition="'$(HelloBundlerDmgBackgroundFile)' != ''">$(HelloBundlerDmgBackgroundFile)</BundlerMacDmgBackgroundFile>
    <BundlerMacDmgBackgroundFile Condition="'$(HelloBundlerDmgBackgroundFile)' == ''">$(HelloBundlerAppAssets)dmg\bg.png</BundlerMacDmgBackgroundFile>
    <BundlerMacDmgVolumeIconFile Condition="'$(HelloBundlerDmgVolumeIconFile)' != ''">$(HelloBundlerDmgVolumeIconFile)</BundlerMacDmgVolumeIconFile>
    <BundlerMacDmgVolumeIconFile Condition="'$(HelloBundlerDmgVolumeIconFile)' == ''">$(HelloBundlerAppAssets)dmg\volume.icns</BundlerMacDmgVolumeIconFile>

    <!-- EULA：默认用公共 BundlerLicenseFile（Assets/common/LICENSE.txt），挂载时弹许可面板；
         -p:HelloBundlerDmgLicenseFile=none 不注入 SLA，也可改指自有许可文件。 -->
    <BundlerLicenseFile Condition="'$(HelloBundlerDmgLicenseFile)' == 'none'"></BundlerLicenseFile>
    <BundlerLicenseFile Condition="'$(HelloBundlerDmgLicenseFile)' != '' and '$(HelloBundlerDmgLicenseFile)' != 'none'">$(HelloBundlerDmgLicenseFile)</BundlerLicenseFile>

    <!-- DMG 本体签名：identity（"-"=ad-hoc）与临时钥匙串证书互斥。 -->
    <BundlerMacDmgSignIdentity Condition="'$(HelloBundlerDmgSignIdentity)' != ''">$(HelloBundlerDmgSignIdentity)</BundlerMacDmgSignIdentity>
    <BundlerMacDmgTemporaryCertificateFile Condition="'$(HelloBundlerDmgSignCertificatePath)' != ''">$(HelloBundlerDmgSignCertificatePath)</BundlerMacDmgTemporaryCertificateFile>
    <BundlerMacDmgTemporaryCertificatePassword Condition="'$(HelloBundlerDmgSignCertificatePassword)' != ''">$(HelloBundlerDmgSignCertificatePassword)</BundlerMacDmgTemporaryCertificatePassword>
  </PropertyGroup>
</Project>
